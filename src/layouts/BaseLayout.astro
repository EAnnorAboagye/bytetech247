---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { siteConfig } from "../config";
import { siteWideJsonLd, absoluteUrl } from "../lib/json-ld";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";

interface Props {
  title?: string;
  description?: string;
  showReadingProgress?: boolean;
  /** Absolute OG/Twitter image URL. Defaults to siteConfig.defaultOgImage. */
  image?: string;
  /** og:type — "article" on post pages, "website" everywhere else. */
  type?: "website" | "article";
  /**
   * Page-specific JSON-LD (e.g. Article + BreadcrumbList from the post
   * template). Site-wide WebSite/Organization blocks are always injected
   * on top of this, not instead of it.
   */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Root-relative URL of the page's LCP image, preloaded if given. */
  preloadImage?: string;
  /** Absolute URL of the post's plain-Markdown export ([slug].md.ts), if any. */
  markdownUrl?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  showReadingProgress = false,
  image = siteConfig.defaultOgImage ?? undefined,
  type = "website",
  jsonLd,
  preloadImage,
  markdownUrl,
} = Astro.props;

// Computed per-page, not a sitewide constant — every page needs its own
// canonical URL (build-spec.md Phase 9; this was the site's single
// highest-impact SEO bug before this fix).
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;
const absoluteImage = image ? absoluteUrl(image) : undefined;

const jsonLdBlocks = [
  ...siteWideJsonLd(),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Google tag (gtag.js) — loads unconditionally for every visitor, no
         consent gate (a deliberate decision made 2026-08-04, replacing the
         earlier consent-gated CookieConsent.astro component; see
         privacy.astro's analytics section, which must stay consistent
         with this).

         The actual gtag.js fetch is deferred until the window "load" event,
         not a static <script src> tag — the old consent-gated version
         never made this request during an automated Lighthouse audit
         (nothing clicks Accept), so this LCP regression only appeared once
         loading went unconditional. A static tag with `async` still gets
         default (High) fetch priority in Chrome, competing with the page's
         real LCP resources for early bandwidth; `fetchpriority="low"`
         measured 2414ms locally (comfortably under the 3000ms budget) but
         still failed the same threshold on the GitHub Actions runner twice
         — a soft priority hint the browser may or may not honor
         consistently isn't reliable enough. Not starting the fetch until
         "load" (by definition after every LCP candidate has already
         rendered) removes the competition entirely rather than hoping a
         hint wins a scheduling race. -->
    <script define:vars={{ analyticsId: siteConfig.analyticsId }}>
      // A bare top-level `function gtag(){}` here stays scoped to this
      // script's own wrapper (Astro implicitly treats a `define:vars`
      // script as `is:inline`, which wraps it) — confirmed live: dataLayer
      // populated correctly for calls made right here, but `window.gtag`
      // itself came back undefined, meaning nothing else on the page could
      // ever call gtag() again. Assigning to `window.gtag` explicitly
      // avoids that trap.
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(...args) {
        window.dataLayer.push(args);
      };
      window.gtag("js", new Date());
      window.gtag("config", analyticsId);

      window.addEventListener("load", () => {
        const gtagSrc = `https://www.googletagmanager.com/gtag/js?id=${analyticsId}`;
        // Trusted Types (enforced via the Content-Security-Policy header,
        // see scripts/generate-security-headers.mjs) rejects a plain
        // string assigned to script.src — this policy only ever returns
        // the one hardcoded gtag.js URL built above, never an
        // attacker-influenced value, which is what makes it a real
        // sanitizer rather than a pass-through that defeats the point of
        // Trusted Types. Firefox/Safari don't implement
        // window.trustedTypes yet, so this falls back to the plain string
        // there — nothing to satisfy without the enforcement header.
        const scriptUrl = window.trustedTypes
          ? window.trustedTypes
              .createPolicy("gtag-loader", {
                createScriptURL: (url) =>
                  url === gtagSrc ? url : "about:blank",
              })
              .createScriptURL(gtagSrc)
          : gtagSrc;
        const script = document.createElement("script");
        script.async = true;
        script.fetchPriority = "low";
        script.src = scriptUrl;
        document.head.appendChild(script);
      });
    </script>
    <!-- Cloudflare Web Analytics, self-hosted (Manual Setup) — see the
         cloudflareBeaconToken comment in src/config.ts for why this isn't
         left to the zone's Automatic Setup. A same-origin external
         <script src>, same as gtag.js below: already covered by
         script-src's static.cloudflareinsights.com host allowlist, no
         hash needed. -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({
        token: siteConfig.cloudflareBeaconToken,
      })}></script>
    <!-- Backup ownership-verification method alongside the DNS TXT record
         already in place (Cloudflare DNS) — Google Search Console's
         "additional verification methods" page for
         https://www.bytetech247.com/, added so verification doesn't
         depend solely on the DNS record surviving forever. Do not remove:
         GSC re-checks this tag periodically even after initial
         verification succeeds. -->
    <meta
      name="google-site-verification"
      content="Q7Gw17KC8cG9r4zyeMycGAfPXpAzdGeThLa9evSl-54"
    />
    <script is:inline>
      // Dark mode, applied before first paint to avoid a flash of the
      // wrong theme (build-spec.md Phase 5) — a manually-saved preference
      // wins, otherwise this follows the system preference.
      //
      // Also re-applied on "astro:after-swap", not just once at parse
      // time — confirmed live: after a View Transition navigation, the
      // new page's <html> had no data-theme attribute at all, even though
      // localStorage still correctly had "dark" saved (the toggle itself
      // was never broken). This inline <head> script only runs once, on
      // the true first load; Astro's ClientRouter swaps in each new
      // page's content without re-executing it, so a saved dark
      // preference silently stopped applying after the very first
      // navigation, reading as "toggle it dark, click somewhere, it turns
      // white." after-swap (not the later page-load event) is Astro's own
      // documented hook for exactly this — it fires right after the DOM
      // swap, before the next paint, so there's no flash of the wrong
      // theme either.
      function applyStoredTheme() {
        const stored = localStorage.getItem("theme");
        const theme =
          stored ??
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.setAttribute("data-theme", theme);
      }
      applyStoredTheme();
      document.addEventListener("astro:after-swap", applyStoredTheme);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.name}
      href={`${siteConfig.url}/rss.xml`}
    />
    {
      markdownUrl && (
        <link rel="alternate" type="text/markdown" href={markdownUrl} />
      )
    }

    <!-- Favicon set: SVG for modern browsers, ICO fallback for everything
         else (older browsers and some crawlers don't render SVG favicons),
         apple-touch-icon for iOS home-screen bookmarks. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0D9488" />

    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Twitter — build-spec.md Phase 9 §11: mirrors the
         locked title/description exactly, one source, no per-platform
         variant copy. -->
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          fetchpriority="high"
        />
      )
    }

    {
      jsonLdBlocks.map((block) => (
        // Escaping "<" prevents a "</script>"-containing string anywhere in
        // the data (e.g. a post title) from breaking out of the script tag.
        <script
          type="application/ld+json"
          set:html={JSON.stringify(block).replace(/</g, "\\u003c")}
        />
      ))
    }

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <Header />

    {showReadingProgress && <div class="reading-progress" aria-hidden="true" />}

    <main id="main-content" tabindex="-1" data-pagefind-body>
      <slot />
    </main>

    <Footer />

    <CommandPalette />

    <script>
      // Astro's View Transitions swap content client-side, and can leave
      // focus stranded on a now-detached element (or reset to <body> with
      // no context) — it doesn't manage this correctly by default
      // (build-spec.md Phase 6). Move focus to the new page's heading so
      // screen reader users get proper context after every navigation.
      document.addEventListener("astro:page-load", () => {
        const heading = document.querySelector<HTMLElement>("main h1");
        if (!heading) return;
        if (!heading.hasAttribute("tabindex")) {
          heading.setAttribute("tabindex", "-1");
        }
        heading.focus();
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--spacing);
    z-index: 100;
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3);
    background-color: var(--color-accent);
    color: var(--color-accent-fg);
    border-radius: 0.375rem;
    text-decoration: none;
  }

  .skip-link:focus {
    top: var(--spacing);
  }

  .reading-progress {
    position: sticky;
    top: 0;
    z-index: 20;
    height: 3px;
    background-color: var(--color-accent);
    transform-origin: left;
    transform: scaleX(0);
    animation: reading-progress-fill linear;
    animation-timeline: scroll(root);
  }

  @keyframes reading-progress-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      animation: none;
      transform: scaleX(0);
    }
  }
</style>

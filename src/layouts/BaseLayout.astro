---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { siteConfig } from "../config";
import { siteWideJsonLd, absoluteUrl } from "../lib/json-ld";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";

interface Props {
  title?: string;
  description?: string;
  showReadingProgress?: boolean;
  /** Absolute OG/Twitter image URL. Defaults to siteConfig.defaultOgImage. */
  image?: string;
  /** og:type — "article" on post pages, "website" everywhere else. */
  type?: "website" | "article";
  /**
   * Page-specific JSON-LD (e.g. Article + BreadcrumbList from the post
   * template). Site-wide WebSite/Organization blocks are always injected
   * on top of this, not instead of it.
   */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Root-relative URL of the page's LCP image, preloaded if given. */
  preloadImage?: string;
  /** Absolute URL of the post's plain-Markdown export ([slug].md.ts), if any. */
  markdownUrl?: string;
  /**
   * Set on tag pages, /archive/, and legal/about pages (contact, privacy,
   * terms, affiliate-disclosure, editorial-policy) — Google should only
   * index category pages and posts, not these navigation/utility pages.
   * `follow` (not a bare `noindex`) so link equity still flows through
   * them to the posts they list/link to.
   */
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  showReadingProgress = false,
  image = siteConfig.defaultOgImage ?? undefined,
  type = "website",
  jsonLd,
  preloadImage,
  markdownUrl,
  noindex = false,
} = Astro.props;

// Computed per-page, not a sitewide constant — every page needs its own
// canonical URL (build-spec.md Phase 9; this was the site's single
// highest-impact SEO bug before this fix).
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;
const absoluteImage = image ? absoluteUrl(image) : undefined;

const jsonLdBlocks = [
  ...siteWideJsonLd(),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Trusted Types default policy — required for Astro's own ClientRouter
         (astro:transitions) to function under this page's
         require-trusted-types-for 'script' CSP directive (see
         applyCsp()/cspFor() in worker/index.ts, which generates this
         header per-request — moved there from a static build-time file
         2026-08-06 to support a real per-request CSP nonce). ClientRouter
         isn't Trusted-Types-aware: every client-side navigation calls
         `new DOMParser().parseFromString(html, ...)` on the fetched page
         internally, and a raw string into that sink throws
         "This document requires 'TrustedHTML' assignment" with no default
         policy registered — confirmed live: with the CSP header actually
         enforced (astro dev/preview never run the Worker that sets this
         header, so this never surfaced in local testing or e2e), every
         single link click site-wide silently failed to navigate. This
         same pass-through policy is also what makes AdSense's own
         internal dynamic script injection work under Trusted Types
         without a dedicated policy of its own — any caller that doesn't
         request a specific named policy falls back to this one.
         Registering the identity 'default' policy here is safe for
         ClientRouter specifically because its only caller in practice is
         ClientRouter fetching *our own* same-origin page HTML from this
         build — never attacker-controlled data. It's a deliberate,
         separate tradeoff that this same pass-through also covers
         AdSense's internal script injection, which this site can't
         audit or scope as narrowly (AdSense ships no Trusted Types
         policy of its own) — accepted because script-src's nonce +
         'strict-dynamic' is what actually gates *which* scripts get to
         run at all; this policy only governs *how* an already-trusted
         script is allowed to keep injecting more content once running.
         Must run before <ClientRouter /> attaches its navigation listeners
         (i.e., before anything below can trigger a client-side nav), so
         it's the very first script in <head>. -->
    <script is:inline>
      if (window.trustedTypes?.createPolicy) {
        window.trustedTypes.createPolicy("default", {
          createHTML: (html) => html,
          createScript: (script) => script,
          createScriptURL: (url) => url,
        });
      }
    </script>
    <!-- Google tag (gtag.js) — loads unconditionally for every visitor, no
         consent gate (a deliberate decision made 2026-08-04, replacing the
         earlier consent-gated CookieConsent.astro component; see
         privacy.astro's analytics section, which must stay consistent
         with this). Only analytics_storage is granted, not the three
         ad_* signals — confirmed live via a 2026-08-06 PageSpeed Insights
         audit (Best Practices 92/100): granting ad_storage/ad_user_data/
         ad_personalization makes gtag.js attempt Google Ads remarketing
         and audience-building requests (stats.g.doubleclick.net,
         google.com/ads/ga-audiences) plus a dynamically-injected inline
         script for the same feature — none of which were in this site's
         CSP allowlist at the time, correctly, since this site didn't run
         ads yet and privacy.astro only disclosed Analytics, never
         remarketing/advertising. That mismatch was firing blocked-by-CSP
         console errors on every pageview, which is what was actually
         costing the Best Practices points.

         Still denied now that AdSense is integrated (2026-08-06): denying
         ad_storage/ad_user_data/ad_personalization means AdSense serves
         non-personalized ads only, which Google explicitly supports
         without any consent UI. Granting them would require a
         Google-certified Consent Management Platform for EEA/UK/Swiss
         visitors under Google's EU User Consent Policy — this site has no
         CMP (the 2026-08-04 decision above removed the old
         CookieConsent.astro gate entirely), so granting ad consent by
         default would violate that policy the moment a real EEA/UK
         visitor loads the page. Revisit only alongside adding a real CMP.

         gtag.js is now a static `<script defer fetchpriority="low" src>`
         tag (2026-08-20), not window.load-deferred JS-created injection —
         reverting the 2026-08-06 fix below because that fix is *why* an
         automated GA-verification check against the live index page
         reported no tracking code found: a tool that fetches raw HTML
         without executing JS (or without waiting past window.load) never
         sees a <script src="...gtag/js..."> element at all when it's only
         ever created via document.createElement() inside a "load"
         listener — there's no static tag in the response body for it to
         find, ever, regardless of how long it waits.

         This isn't simply re-trying the exact thing the 2026-08-06 fix
         moved away from: that regression was `async` + `fetchpriority=
         "low"`, which only deprioritizes *fetch start*, not *execution*.
         `async` still runs the instant the (small, ~28KB) file finishes
         downloading, which race-availability plus a background fetch can
         still land well before paint. `defer` is a different scheduling
         primitive: execution is withheld until after the document has
         finished parsing (right before DOMContentLoaded), which is a hard
         ordering guarantee the browser enforces, not a priority hint it
         may or may not honor — the actual documented failure mode of the
         `async` attempt. Validated via this repo's own Lighthouse CI gate
         (.lighthouserc.json, LCP <= 3000ms) against a real PR before
         merging, not assumed safe by reasoning alone — see that PR for
         the before/after numbers. If a future regression shows up here
         again, the fallback is the same as before (window.load), not a
         third scheduling attribute to try blind. -->
    <script define:vars={{ analyticsId: siteConfig.analyticsId }}>
      // A bare top-level `function gtag(){}` here stays scoped to this
      // script's own wrapper (Astro implicitly treats a `define:vars`
      // script as `is:inline`, which wraps it) — confirmed live: dataLayer
      // populated correctly for calls made right here, but `window.gtag`
      // itself came back undefined, meaning nothing else on the page could
      // ever call gtag() again. Assigning to `window.gtag` explicitly
      // avoids that trap.
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(...args) {
        window.dataLayer.push(args);
      };
      // Explicit Consent Mode v2 default — confirmed live: with no consent
      // signal sent at all, real gtag.js (once loaded) initialized fine
      // (google_tag_manager populated, dataLayer had gtm.load etc.) but
      // never made a single network request to any Analytics endpoint —
      // not even a denied/cookieless ping, verified via the Performance
      // Resource Timing API and by monkey-patching fetch/sendBeacon/XHR
      // before manually firing a gtag('event', ...) call. Google's current
      // default for gtag.js is to treat an *unset* consent state as
      // restricted rather than unrestricted, so "no consent gate" (this
      // site's actual policy — see privacy.astro) has to be stated
      // explicitly, not left implicit, to actually take effect. Must come
      // before the "js"/"config" calls below per Google's documented
      // ordering.
      window.gtag("consent", "default", {
        ad_storage: "denied",
        analytics_storage: "granted",
        ad_user_data: "denied",
        ad_personalization: "denied",
      });
      window.gtag("js", new Date());
      // send_page_view: false — this site uses <ClientRouter /> below, so
      // every internal link click is a soft, client-side navigation (fetch
      // + DOM swap), never a real browser page load. GA4 has no way to see
      // those on its own: gtag.js's automatic page_view only fires once,
      // right here, for whichever page the visitor actually landed on.
      // Confirmed live: Realtime showed a visitor for the entry page only,
      // every subsequent article click during that same visit went
      // unrecorded — a well-documented gap in Google's own SPA guidance
      // (developers.google.com/analytics/devguides/collection/ga4/views),
      // not something Enhanced Measurement's history-listener can be
      // assumed to cover, since that's a per-property dashboard toggle
      // this code can't see or depend on. The astro:page-load listener
      // below fires this same page_view manually instead — once for this
      // initial load (it fires on the true first load too, not just
      // transitions) and again on every ClientRouter navigation, so it's
      // the single source of pageview truth rather than two overlapping
      // ones.
      window.gtag("config", analyticsId, { send_page_view: false });

      document.addEventListener("astro:page-load", () => {
        window.gtag("event", "page_view", {
          page_location: window.location.href,
          page_path: window.location.pathname,
          page_title: document.title,
        });
      });
    </script>
    <!-- gtag.js itself — a static tag, not a JS-driven Trusted Types sink
         (unlike the JS-created version this replaced), so it's unaffected
         by require-trusted-types-for the same way the AdSense tag below
         already is. `defer`, not `async`: see the long comment above this
         block for why that's the load-bearing difference from the
         attribute combination that previously regressed LCP.
         `fetchpriority="low"` is additionally applied on top of `defer` —
         doesn't change the *ordering* guarantee defer already provides,
         but still deprioritizes the download itself against whatever the
         LCP candidate needs. -->
    <script
      defer
      fetchpriority="low"
      src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.analyticsId}`}
    ></script>
    <!-- Cloudflare Web Analytics, self-hosted (Manual Setup) — see the
         cloudflareBeaconToken comment in src/config.ts for why this isn't
         left to the zone's Automatic Setup. A same-origin-authored
         <script src> tag, same as gtag.js below and the AdSense tag that
         follows: gets its CSP nonce from the Worker's HTMLRewriter pass
         (worker/index.ts), not a host allowlist entry. -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({
        token: siteConfig.cloudflareBeaconToken,
      })}></script>
    <!-- Google AdSense loader — enables Auto Ads once turned on in the
         AdSense dashboard, no ad-unit markup needed here. A static
         <script src>, not a JS-driven Trusted Types sink (unlike the
         gtag.js loader above), so it's unaffected by
         require-trusted-types-for; it gets its CSP nonce the same way
         the two tags above do. See adsensePublisherId's comment in
         src/config.ts for why ad_storage/ad_user_data/ad_personalization
         stay denied (non-personalized ads only) until this site has a
         real Consent Management Platform. -->
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsensePublisherId}`}
      crossorigin="anonymous"></script>
    <!-- Activates every manually-placed ad slot on the page (AdSlot.astro
         instances, plus the raw <ins class="adsbygoogle"> markup the
         in-article rehype plugins insert directly into compiled MDX —
         see rehype-quick-answer.mjs and rehype-in-article-ads.mjs) — one
         delegated pass here instead of a copy of this same script
         per-component-instance. is:inline: window.adsbygoogle is an
         untyped third-party global with no ambient declaration in this
         project; a normal processed <script> here would fail
         `astro check`, same reasoning as the gtag setup above. -->
    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        const unfilled = document.querySelectorAll(
          "ins.adsbygoogle:not([data-adsbygoogle-status])",
        );
        for (let i = 0; i < unfilled.length; i++) {
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch {
            // AdSense script blocked (ad blocker, offline, not yet
            // approved) — every slot's reserved min-height keeps layout
            // stable either way.
          }
        }
      });
    </script>
    <!-- Backup ownership-verification method alongside the DNS TXT record
         already in place (Cloudflare DNS) — Google Search Console's
         "additional verification methods" page for
         https://www.bytetech247.com/, added so verification doesn't
         depend solely on the DNS record surviving forever. Do not remove:
         GSC re-checks this tag periodically even after initial
         verification succeeds. -->
    <meta
      name="google-site-verification"
      content="Q7Gw17KC8cG9r4zyeMycGAfPXpAzdGeThLa9evSl-54"
    />
    <!-- Redundant AdSense ownership signal alongside the ad-serving script
         itself (adsbygoogle.js, further down this file) and the ads.txt
         declaration (public/ads.txt) — same defensive-redundancy reasoning
         as the Search Console tag above: three independent ways for
         Google to confirm this property is legitimately connected to this
         AdSense account, rather than depending on any single one. -->
    <meta
      name="google-adsense-account"
      content={siteConfig.adsensePublisherId}
    />
    <script is:inline>
      // Dark mode, applied before first paint to avoid a flash of the
      // wrong theme (build-spec.md Phase 5) — a manually-saved preference
      // wins, otherwise this follows the system preference.
      //
      // Also re-applied on "astro:after-swap", not just once at parse
      // time — confirmed live: after a View Transition navigation, the
      // new page's <html> had no data-theme attribute at all, even though
      // localStorage still correctly had "dark" saved (the toggle itself
      // was never broken). This inline <head> script only runs once, on
      // the true first load; Astro's ClientRouter swaps in each new
      // page's content without re-executing it, so a saved dark
      // preference silently stopped applying after the very first
      // navigation, reading as "toggle it dark, click somewhere, it turns
      // white." after-swap (not the later page-load event) is Astro's own
      // documented hook for exactly this — it fires right after the DOM
      // swap, before the next paint, so there's no flash of the wrong
      // theme either.
      function applyStoredTheme() {
        const stored = localStorage.getItem("theme");
        const theme =
          stored ??
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.setAttribute("data-theme", theme);
      }
      applyStoredTheme();
      document.addEventListener("astro:after-swap", applyStoredTheme);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.name}
      href={`${siteConfig.url}/rss.xml`}
    />
    {
      markdownUrl && (
        <link rel="alternate" type="text/markdown" href={markdownUrl} />
      )
    }

    <!-- Favicon set: SVG for modern browsers, ICO fallback for everything
         else (older browsers and some crawlers don't render SVG favicons),
         apple-touch-icon for iOS home-screen bookmarks. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0D9488" />

    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Twitter — build-spec.md Phase 9 §11: mirrors the
         locked title/description exactly, one source, no per-platform
         variant copy. -->
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          fetchpriority="high"
        />
      )
    }

    {
      jsonLdBlocks.map((block) => (
        // Escaping "<" prevents a "</script>"-containing string anywhere in
        // the data (e.g. a post title) from breaking out of the script tag.
        <script
          type="application/ld+json"
          set:html={JSON.stringify(block).replace(/</g, "\\u003c")}
        />
      ))
    }

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <Header />

    {showReadingProgress && <div class="reading-progress" aria-hidden="true" />}

    <main id="main-content" tabindex="-1" data-pagefind-body>
      <slot />
    </main>

    <Footer />

    <CommandPalette />

    <script>
      // Astro's View Transitions swap content client-side, and can leave
      // focus stranded on a now-detached element (or reset to <body> with
      // no context) — it doesn't manage this correctly by default
      // (build-spec.md Phase 6). Move focus to the new page's heading so
      // screen reader users get proper context after every navigation.
      document.addEventListener("astro:page-load", () => {
        const heading = document.querySelector<HTMLElement>("main h1");
        if (!heading) return;
        if (!heading.hasAttribute("tabindex")) {
          heading.setAttribute("tabindex", "-1");
        }
        heading.focus();
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--spacing);
    z-index: 100;
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3);
    background-color: var(--color-accent);
    color: var(--color-accent-fg);
    border-radius: 0.375rem;
    text-decoration: none;
  }

  .skip-link:focus {
    top: var(--spacing);
  }

  .reading-progress {
    position: sticky;
    top: 0;
    z-index: 20;
    height: 3px;
    background-color: var(--color-accent);
    transform-origin: left;
    transform: scaleX(0);
    animation: reading-progress-fill linear;
    animation-timeline: scroll(root);
  }

  @keyframes reading-progress-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      animation: none;
      transform: scaleX(0);
    }
  }
</style>

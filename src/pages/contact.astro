---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";

const socialLinks = Object.entries(siteConfig.social);
---

<BaseLayout
  title={`Contact — ${siteConfig.name}`}
  description={`How to reach ${siteConfig.name}.`}
>
  <article class="legal">
    <h1>Contact</h1>
    <p>
      Questions, corrections, story tips, or anything else — the fastest way to
      reach {siteConfig.name} is email:
    </p>
    <p>
      <a href={`mailto:${siteConfig.contactEmail}`} class="contact-email">
        {siteConfig.contactEmail}
      </a>
    </p>
    <p>
      Prefer a form instead of email?{" "}
      <a href={siteConfig.contactFormUrl}>Use the contact form</a> — it goes to the
      same inbox.
    </p>

    {
      socialLinks.length > 0 && (
        <>
          <p>You can also find {siteConfig.name} on:</p>
          <ul class="contact-social">
            {socialLinks.map(([platform, href]) => (
              <li>
                <a href={href}>{platform}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <h2>Reporting a security issue</h2>
    <p>
      Found a security vulnerability rather than a content issue? Please use the
      contact method listed in{" "}
      <a href="/.well-known/security.txt">security.txt</a> (RFC 9116) instead, so
      it's handled separately from general messages.
    </p>

    <p class="legal__disclaimer">
      Spotted something outdated or incorrect in a post? See the{" "}
      <a href="/editorial-policy/">Editorial Policy</a> for how corrections are handled.
    </p>
  </article>
</BaseLayout>

<style>
  .contact-email {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-accent);
  }

  .contact-social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: calc(var(--spacing) * 3);
    text-transform: capitalize;
  }

  .contact-social a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
</style>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Grid from "../../components/layout/Grid.astro";
import PostCard from "../../components/PostCard.astro";
import { CATEGORIES, getCategoryName, siteConfig } from "../../config";
import { collectionPageJsonLd, breadcrumbJsonLd } from "../../lib/json-ld";

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
  }));
}

const { category } = Astro.params;
const categoryName = getCategoryName(category);
const description = `All ${categoryName} posts.`;

const posts = (
  await getCollection("blog", (post) => post.data.category === category)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Same "visible and structured data agree" principle the article template
// follows (build-spec.md §10) — this page previously emitted only the
// sitewide WebSite/Organization blocks from BaseLayout, nothing describing
// the archive itself.
const pageUrl = new URL(Astro.url.pathname, siteConfig.url).href;
const jsonLdBlocks = [
  collectionPageJsonLd({ name: categoryName, description, url: pageUrl }),
  breadcrumbJsonLd([
    { name: "Home", url: siteConfig.url },
    { name: categoryName, url: pageUrl },
  ]),
];
---

<BaseLayout
  title={`${categoryName} — Archive`}
  description={description}
  jsonLd={jsonLdBlocks}
>
  <p><a href="/" class="home-link">Home</a></p>
  <h1>{categoryName}</h1>

  {
    posts.length === 0 ? (
      <p>No posts yet in this category.</p>
    ) : (
      <>
        <h2 class="section-heading">All posts</h2>
        <Grid minItemWidth="18rem" space="4">
          {posts.map((post, index) => (
            <PostCard post={post} eager={index < 4} />
          ))}
        </Grid>
      </>
    )
  }
</BaseLayout>

<style>
  .home-link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }

  .section-heading {
    font-size: var(--text-2xl);
    margin-top: calc(var(--spacing) * 6);
    margin-bottom: calc(var(--spacing) * 4);
    color: var(--color-fg);
  }
</style>

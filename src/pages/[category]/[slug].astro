---
import { getCollection, render } from "astro:content";
import type { InferGetStaticPropsType } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Grid from "../../components/layout/Grid.astro";
import TOCSidebar from "../../components/TOCSidebar.astro";
import PostCard from "../../components/PostCard.astro";
import TagPill from "../../components/TagPill.astro";
import Figure from "../../components/Figure.astro";
import Callout from "../../components/Callout.astro";
import CodeTabs from "../../components/CodeTabs.astro";
import Benchmark from "../../components/Benchmark.astro";
import LastVerified from "../../components/LastVerified.astro";
import FaqSection from "../../components/FaqSection.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import AuthorBio from "../../components/AuthorBio.astro";
import AdSlot from "../../components/AdSlot.astro";
import { Picture, getImage } from "astro:assets";
import { siteConfig, getCategoryName } from "../../config";
import { validateCoverImage } from "../../lib/validate-cover-image";
import { validateNoH1InBody } from "../../lib/validate-no-h1-in-body";
import { calculateReadingTime } from "../../lib/reading-time";
import { getRelatedPosts } from "../../lib/related-posts";
import { getRecentPosts } from "../../lib/recent-posts";
import { getLastVerifiedDate } from "../../lib/last-verified";
import { articleJsonLd, breadcrumbJsonLd, faqJsonLd } from "../../lib/json-ld";
import { slugifyTag } from "../../lib/taxonomy";
import { pageTitle } from "../../lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  for (const post of posts) {
    validateCoverImage(post);
    validateNoH1InBody(post);
  }
  return posts.map((post) => ({
    params: { category: post.data.category, slug: post.id },
    props: { post, allPosts: posts },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, allPosts } = Astro.props as Props;
const { Content, headings } = await render(post);
const categoryName = getCategoryName(post.data.category);
const readingTime = calculateReadingTime(post.body ?? "");
const relatedPosts = getRelatedPosts(post, allPosts);
const recentPosts = getRecentPosts(
  post,
  allPosts,
  relatedPosts.map((p) => p.id),
);
const lastVerifiedDate = getLastVerifiedDate(
  `src/content/blog/${post.id}/index.mdx`,
);

// Google's Article structured data guidelines recommend supplying the
// same image in 16x9, 4x3, and 1x1 for best rich-result eligibility
// across its different surfaces (Search, Discover, Images) — these two
// crops exist only for the JSON-LD image array below, never rendered on
// the page itself, so a plain, universally-compatible JPG is the right
// choice here, not the AVIF/WebP used for the actual visible cover.
//
// Sizes are bounded by the source's actual height (validateCoverImage
// only guarantees >=1600x900, i.e. a 16:9 minimum), not an arbitrary
// round number — Astro/sharp's image service defaults to
// withoutEnlargement: true, so asking for a 1x1 crop taller than the
// source's own height (e.g. 1200x1200 against a 1600x900 source)
// silently gets capped back down to the source height instead of
// actually cropping square. 900x900 is the largest square this source
// can provide without upscaling; still far above Google's ~50,000px
// minimum for this field.
const cropped4x3 = await getImage({
  src: post.data.coverImage,
  width: 1200,
  height: 900,
  format: "jpg",
});
const cropped1x1 = await getImage({
  src: post.data.coverImage,
  width: 900,
  height: 900,
  format: "jpg",
});

// BaseLayout's preloadImage hint must point at the same small, already-
// optimized asset the cover <Picture> below actually requests at mobile
// widths — not post.data.coverImage.src, which is the raw, un-resized
// source file. That mismatch was harmless when covers were generated
// placeholders (small either way), but a real photo's raw source can be
// 5-10x heavier than its 640w AVIF, and preloading it at fetchpriority
// "high" competes with, rather than helps, the actual LCP request —
// same width/format the Picture component generates below, so this
// reuses that build output instead of generating a second copy.
const preloadCover = await getImage({
  src: post.data.coverImage,
  width: 640,
  format: "avif",
});

// Same hierarchy as the visible breadcrumb below, per build-spec.md §10 —
// visible and structured data must agree, not drift independently.
const pageUrl = new URL(Astro.url.pathname, siteConfig.url).href;
const markdownUrl = new URL(
  `/${post.data.category}/${post.id}.md`,
  siteConfig.url,
).href;
const categoryUrl = new URL(`/${post.data.category}/`, siteConfig.url).href;
const breadcrumbItems = [
  { name: "Home", url: siteConfig.url },
  { name: categoryName, url: categoryUrl },
  { name: post.data.title, url: pageUrl },
];
const articleJsonLdBlocks = [
  articleJsonLd(post, pageUrl, lastVerifiedDate, [
    cropped4x3.src,
    cropped1x1.src,
  ]),
  breadcrumbJsonLd(breadcrumbItems),
  ...(post.data.faq.length > 0 ? [faqJsonLd(post.data.faq)] : []),
];

const seriesPosts = post.data.series
  ? allPosts
      .filter((p) => p.data.series === post.data.series)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const seriesIndex = seriesPosts.findIndex((p) => p.id === post.id);
const prevInSeries = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : undefined;
const nextInSeries =
  seriesIndex >= 0 && seriesIndex < seriesPosts.length - 1
    ? seriesPosts[seriesIndex + 1]
    : undefined;
---

<BaseLayout
  title={pageTitle(post.data.title, categoryName)}
  description={post.data.description}
  type="article"
  image={post.data.coverImage.src}
  preloadImage={preloadCover.src}
  markdownUrl={markdownUrl}
  jsonLd={articleJsonLdBlocks}
  showReadingProgress
>
  <div class="post-layout">
    <AdSlot
      adSlot={siteConfig.adSlots.articleHeader}
      minHeight="100px"
      label="Advertisement"
      class="post-header-ad"
    />

    <article class="post-article">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol class="breadcrumb__list">
          <li><a href="/">Home</a></li>
          <li><a href={`/${post.data.category}/`}>{categoryName}</a></li>
          <li aria-current="page">{post.data.title}</li>
        </ol>
      </nav>

      <h1>{post.data.title}</h1>
      <p class="post-meta">
        {siteConfig.author.name && <>By {siteConfig.author.name} · </>}
        <time datetime={post.data.date.toISOString()}>
          {
            post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })
          }
        </time>{" "}
        · {readingTime} min read
      </p>
      <LastVerified date={lastVerifiedDate} />
      <ShareButtons url={pageUrl} title={post.data.title} class="post-share" />
      <p class="post-markdown-link">
        <a href={markdownUrl}>View as Markdown</a>
      </p>

      <Picture
        src={post.data.coverImage}
        alt={post.data.coverImageAlt}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 64rem) 48rem, 100vw"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        class="post-cover"
      />
      {
        post.data.coverImageCredit && (
          <p class="post-cover-credit">
            Photo by{" "}
            <a href={post.data.coverImageCredit.url} rel="noopener">
              {post.data.coverImageCredit.name}
            </a>
          </p>
        )
      }

      <TOCSidebar headings={headings} variant="inline" />

      <AdSlot
        adSlot={siteConfig.adSlots.articleAfterImage}
        minHeight="250px"
        label="Advertisement"
        class="post-ad"
      />

      {
        seriesPosts.length > 1 && (
          <>
            <nav aria-label="Series progress" class="series-nav">
              <p class="series-nav__title">
                {post.data.series} ({seriesIndex + 1} of {seriesPosts.length})
              </p>
              <ol class="series-nav__list">
                {seriesPosts.map((seriesPost, i) => (
                  <li class:list={{ "is-current": seriesPost.id === post.id }}>
                    {seriesPost.id === post.id ? (
                      <span>
                        {i + 1}. {seriesPost.data.title}
                      </span>
                    ) : (
                      <a
                        href={`/${seriesPost.data.category}/${seriesPost.id}/`}
                      >
                        {i + 1}. {seriesPost.data.title}
                      </a>
                    )}
                  </li>
                ))}
              </ol>
            </nav>

            {/* Pillar/cluster ad only exists when the pillar/cluster nav
                 above actually rendered — same automatic-detection
                 principle as the Quick Answer / H2 ads: no series, no
                 slot, not a hidden empty box. */}
            <AdSlot
              adSlot={siteConfig.adSlots.articleAfterPillarCluster}
              minHeight="250px"
              label="Advertisement"
              class="post-ad"
            />
          </>
        )
      }

      {
        /* Quick Answer and every-other-H2 ads are inserted *inside* this
           block by the rehype-in-article-ads.mjs pipeline (astro.config.mjs)
           — there's no Astro-level way to place a component mid-way
           through compiled MDX output, so those two positions emit the
           same .ad-slot markup as raw HTML instead of a real <AdSlot />
           instance. See that file's own comment for why. */
      }
      <div class="article-content">
        <Content components={{ Figure, Callout, CodeTabs, Benchmark }} />
      </div>

      <FaqSection faq={post.data.faq} />

      <AdSlot
        adSlot={siteConfig.adSlots.articleBeforeAuthorBio}
        minHeight="250px"
        label="Advertisement"
        class="post-ad"
      />

      <div class="post-author">
        <AuthorBio />
      </div>

      {
        post.data.tags.length > 0 && (
          <ul class="post-tags">
            {post.data.tags.map((tag) => (
              <li>
                <TagPill href={`/tag/${slugifyTag(tag)}/`}>{tag}</TagPill>
              </li>
            ))}
          </ul>
        )
      }

      {
        (prevInSeries || nextInSeries) && (
          <nav aria-label="Series prev/next" class="series-prev-next">
            {prevInSeries ? (
              <a href={`/${prevInSeries.data.category}/${prevInSeries.id}/`}>
                ← {prevInSeries.data.title}
              </a>
            ) : (
              <span />
            )}
            {nextInSeries && (
              <a href={`/${nextInSeries.data.category}/${nextInSeries.id}/`}>
                {nextInSeries.data.title} →
              </a>
            )}
          </nav>
        )
      }

      {
        relatedPosts.length > 0 && (
          <>
            <AdSlot
              adSlot={siteConfig.adSlots.articleAfterTags}
              minHeight="250px"
              label="Advertisement"
              class="post-ad"
            />
            <section aria-label="Related posts" class="related-posts">
              <h2>Related posts</h2>
              <Grid minItemWidth="16rem" space="4" class="related-posts__grid">
                {relatedPosts.map((related) => (
                  <PostCard post={related} />
                ))}
              </Grid>
            </section>
          </>
        )
      }

      {
        recentPosts.length > 0 && (
          <>
            <AdSlot
              adSlot={siteConfig.adSlots.articleBeforeRecent}
              minHeight="250px"
              label="Advertisement"
              class="post-ad"
            />
            <section aria-label="Recent posts" class="recent-posts">
              <h2>Recent posts</h2>
              <Grid minItemWidth="16rem" space="4" class="recent-posts__grid">
                {recentPosts.map((recent) => (
                  <PostCard post={recent} />
                ))}
              </Grid>
            </section>
          </>
        )
      }
    </article>

    <aside class="post-sidebar">
      <TOCSidebar headings={headings} />
      <AdSlot
        adSlot={siteConfig.adSlots.articleSidebar}
        minHeight="600px"
        label="Advertisement"
        class="post-sidebar__ad"
      />
    </aside>
  </div>
</BaseLayout>

<style>
  /* Overrides the site-wide h1-h6 rule (global.css) for this page's own
     post-title h1 specifically — Plex Mono at full headline scale reads
     wider/heavier than it should for a long title; Plex Serif is the same
     type family's dedicated companion face, a considered swap rather than
     a random third font. In-body h2/h3/h4 get the same treatment further
     down, scoped to .article-content so nav/card/footer headings
     elsewhere keep the brand's Mono voice. */
  h1 {
    font-family: var(--font-serif);
    letter-spacing: normal;
  }

  .post-markdown-link {
    margin: calc(var(--spacing) * 2) 0 0;
    font-size: var(--text-sm);
  }

  .post-markdown-link a {
    color: var(--color-fg-muted);
  }

  .post-markdown-link a:hover {
    text-decoration: underline;
  }

  .post-layout {
    display: grid;
    /* minmax(0, 1fr), not plain 1fr — a bare 1fr still lets this grid
       item refuse to shrink below its content's intrinsic min-width
       (CSS Grid's default), and this article has unwrapped code blocks
       that scroll horizontally on their own (.astro-code below) — without
       the 0 floor here, the whole page was forced wider than the
       viewport on any narrow screen just to fit those, instead of
       letting the code block's own overflow-x:auto handle it. */
    grid-template-columns: minmax(0, 1fr);
    gap: calc(var(--spacing) * 6);
    max-width: 72rem;
    margin-inline: auto;
    /* Horizontal padding deliberately 0 here — <main> (BaseLayout)
       already applies padding-inline as a safety net for pages without
       their own width-constrained wrapper. Adding it again here would
       stack on top of main's, quietly eating ~128px of a 375px phone
       screen (32px main + 32px here, both sides) for zero visual
       reason. Only the vertical padding is this template's own. */
    padding: calc(var(--spacing) * 6) 0;
  }

  @media (min-width: 64rem) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr) 16rem;
      align-items: start;
    }
  }

  /*
   * Reading-column width — confirmed live: with no cap of its own, the
   * article column only ever inherited .post-layout's 72rem/16rem-sidebar
   * math, which works out to roughly 848px wide at a 1440px viewport —
   * close to 100 characters per line at this template's own body font
   * size, well past the ~65-75ch a line of prose stays comfortable to
   * read at before eyes start losing their place jumping back to the
   * left edge. Only matters at wider viewports; mobile/tablet are
   * already narrower than this cap, so nothing changes for them.
   *
   * Applied to everything in the article column *except* the
   * related/recent-posts card grids, which still want the full column
   * width to lay out multiple cards per row — a single comfortable
   * reading measure for the parts a reader actually reads, full width
   * for the parts a reader scans.
   */
  .breadcrumb,
  h1,
  .post-meta,
  :global(.post-share),
  .post-markdown-link,
  .post-cover,
  .post-cover-credit,
  :global(.toc-inline),
  .series-nav,
  .article-content,
  :global(.faq-section),
  .post-author,
  .post-tags,
  .series-prev-next,
  :global(.post-ad) {
    max-width: 46rem;
  }

  /* Below 1024px the grid collapses to one column, which used to leave
     the sidebar TOC stranded at the bottom of the page (after related
     posts) — the inline <details> variant above replaces it there
     instead, so only one of the two is ever visible at a given width. */
  .post-sidebar {
    display: none;
  }

  @media (min-width: 64rem) {
    .post-sidebar {
      display: block;
    }
  }

  :global(.post-sidebar__ad) {
    margin-top: calc(var(--spacing) * 6);
  }

  /* Every AdSlot instance in the article flow (after image, after
     pillar/cluster, before author bio, after tags, before recent) shares
     this one spacing rule — same margin whichever position it's in. */
  :global(.post-ad) {
    margin: calc(var(--spacing) * 8) 0;
  }

  /* The header ad spans the full .post-layout grid width (article column
     + sidebar column combined), not just the article track it would
     otherwise land in as the grid's first child — a leaderboard reads
     as a full-width banner, not a column-width box. grid-column: 1 / -1
     only actually spans two tracks once the sidebar column exists
     (>=64rem); below that .post-layout is a single column already, so
     this is a no-op there, not a conditional rule. */
  :global(.post-header-ad) {
    grid-column: 1 / -1;
    margin: 0 0 calc(var(--spacing) * 2);
  }

  /* The Quick Answer / every-other-H2 ads (rehype-in-article-ads.mjs)
     are raw .ad-slot markup inserted directly into .article-content's
     compiled MDX — same spacing as .post-ad, scoped through
     .article-content so it doesn't need its own :global(.post-ad)
     duplicate selector. */
  .article-content :global(.ad-slot) {
    margin: 2em 0;
  }

  @media (min-width: 64rem) {
    :global(.toc-inline) {
      display: none;
    }
  }

  .breadcrumb {
    margin: calc(var(--spacing) * 2) 0;
  }

  .breadcrumb__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--spacing) * 0.5);
    margin: 0;
    padding: 0;
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }

  .breadcrumb__list li:not(:last-child)::after {
    content: "/";
    margin-left: calc(var(--spacing) * 0.5);
    color: var(--color-border);
  }

  .breadcrumb__list a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--color-fg-muted);
    text-decoration: none;
  }

  .breadcrumb__list a:hover {
    color: var(--color-accent);
  }

  .breadcrumb__list li[aria-current="page"] {
    color: var(--color-fg);
  }

  .post-meta {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  :global(.post-share) {
    margin-top: calc(var(--spacing) * 1);
  }

  :global(.post-share .share-buttons__trigger) {
    padding-left: 0;
  }

  .post-author {
    margin: calc(var(--spacing) * 8) 0;
    padding: calc(var(--spacing) * 4);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background-color: var(--color-bg-subtle);
  }

  .post-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.75rem;
    margin: calc(var(--spacing) * 4) 0;
  }

  .post-cover-credit {
    margin-top: calc(var(--spacing) * -3);
    margin-bottom: calc(var(--spacing) * 4);
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
    text-align: right;
  }

  .post-cover-credit a {
    color: inherit;
  }

  .series-nav {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: calc(var(--spacing) * 3);
    margin: calc(var(--spacing) * 4) 0;
  }

  .series-nav__title {
    font-weight: 600;
    font-size: var(--text-sm);
    margin: 0 0 var(--spacing);
    color: var(--color-fg);
  }

  .series-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 0.5);
    font-size: var(--text-sm);
  }

  .series-nav__list a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--color-fg-muted);
    text-decoration: none;
  }

  .series-nav__list .is-current span {
    color: var(--color-fg);
    font-weight: 600;
  }

  .post-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing);
    margin: calc(var(--spacing) * 6) 0 0;
    padding: 0;
  }

  .series-prev-next {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing);
    margin-top: calc(var(--spacing) * 4);
    padding-top: calc(var(--spacing) * 4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .series-prev-next a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--color-accent);
    text-decoration: none;
  }

  /* Grid.astro (imported above) provides the actual track-sizing — this
     just adds the section's own top margin, not a second copy of the
     same auto-fill logic. */
  .related-posts,
  .recent-posts {
    margin-top: calc(var(--spacing) * 8);
  }

  .related-posts__grid,
  .recent-posts__grid {
    margin-top: calc(var(--spacing) * 4);
  }

  /* Prose rhythm for the rendered MDX body — Tailwind's reset zeroes
     margin on every element by default, and nothing here ever replaced
     it for plain paragraphs/headings/lists (only tables and code blocks
     below had their own rules), so every element rendered flush against
     the next with no vertical separation at all. font-size is a scoped
     fluid clamp (not the global --text-base) so this reading column gets
     slightly larger type on wide viewports without resizing buttons/nav/
     forms sitewide; line-height is a touch more open than the site
     default for sustained reading. */
  .article-content {
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.125rem);
    line-height: 1.7;
  }

  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    font-family: var(--font-serif);
    letter-spacing: normal;
  }

  /* More space above a heading than below it, so it visually belongs to
     the section it introduces rather than the one before it. Paragraphs
     only carry bottom margin — combined with zero top margin on both
     sides, two adjacent elements never double up their gap. */
  .article-content :global(p) {
    margin: 0 0 1.25em;
  }

  /* Tailwind's Preflight resets <a> to color: inherit / text-decoration:
     inherit, so every citation and internal link in the rendered MDX body
     previously matched the surrounding paragraph color exactly, with no
     underline — including every external citation added across the site's
     own content pass, confirmed live as genuinely unstyled before this
     rule existed anywhere outside @media print. Underline plus a dedicated
     blue (--color-link, not --color-accent's teal — blue is the color
     readers already recognize as "clickable" at a glance), not color
     alone, since color by itself isn't a reliable enough signal (WCAG
     1.4.1 "Use of Color") — this also directly serves this site's own
     citation/E-E-A-T discipline: a source link that doesn't visually read
     as a link doesn't get clicked or verified.
     :not(.astro-code a) excludes anything inside a rendered code block —
     a URL appearing inside a fenced example is code content, not a real
     citation to follow, and shouldn't be styled like one. */
  .article-content :global(a):not(.astro-code a) {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .article-content :global(a):not(.astro-code a):hover {
    text-decoration-thickness: 2px;
  }

  .article-content :global(h2) {
    margin: 2.5em 0 1em;
  }

  .article-content :global(h3) {
    margin: 2em 0 0.75em;
  }

  .article-content :global(h4) {
    margin: 1.5em 0 0.5em;
  }

  .article-content :global(> :first-child) {
    margin-top: 0;
  }

  /*
   * The "Quick Answer" block (rehype-quick-answer.mjs wraps it in this
   * <aside>) is the one section a skimming reader — human or AI answer
   * engine — should be able to find without reading the rest of the
   * page. The heading itself is restyled down to a small mono label
   * instead of a second copy of the same "Quick Answer" text at heading
   * size right above the answer text — the answer paragraph is what
   * should read as prominent here, not its own label.
   */
  .article-content :global(.quick-answer) {
    margin: 1.5em 0 2em;
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
    background-color: var(--color-bg-subtle);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .article-content :global(.quick-answer > :first-child) {
    margin-top: 0;
  }

  .article-content :global(.quick-answer > :last-child) {
    margin-bottom: 0;
  }

  .article-content :global(.quick-answer h2) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.75em;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 1.25em;
    padding-inline-start: 1.5em;
  }

  .article-content :global(li) {
    margin-top: 0.4em;
  }

  .article-content :global(blockquote) {
    margin: 1.5em 0;
    padding-inline-start: 1em;
    border-left: 3px solid var(--color-border);
    color: var(--color-fg-muted);
  }

  /* GFM table styling, scoped to rendered MDX content — mobile scroll
     wrapper contained to the table itself, not the whole page. */
  .article-content :global(table) {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    margin: calc(var(--spacing) * 4) 0;
  }

  .article-content :global(thead) {
    position: sticky;
    top: 0;
    background-color: var(--color-bg);
  }

  .article-content :global(th),
  .article-content :global(td) {
    border: 1px solid var(--color-border);
    padding: var(--spacing) calc(var(--spacing) * 2);
    text-align: left;
  }

  .article-content :global(tbody tr:nth-child(even)) {
    background-color: var(--color-bg-subtle);
  }

  /*
   * Code blocks — Phase 4's one documented exception to the token-only
   * color rule (Part III of build-spec.md): these are GitHub Dark's own
   * colors, fixed regardless of the site's light/dark toggle, not pulled
   * from the Phase 1 token layer.
   */
  .article-content :global(.code-block) {
    position: relative;
    margin: calc(var(--spacing) * 4) 0;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid #30363d;
  }

  .article-content :global(.code-block__header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 2);
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
  }

  .article-content :global(.code-block__filename) {
    font-size: var(--text-xs);
    font-family: monospace;
    color: #8b949e;
  }

  .article-content :global(.code-block__copy) {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: var(--text-xs);
    color: #8b949e;
    background: none;
    border: 1px solid #30363d;
    border-radius: 0.25rem;
    padding: calc(var(--spacing) * 0.5) var(--spacing);
    cursor: pointer;
  }

  .article-content :global(.code-block__copy:hover) {
    color: #f0f6fc;
    border-color: #8b949e;
  }

  .article-content :global(.astro-code) {
    margin: 0;
    padding: calc(var(--spacing) * 3);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* Inline code (single-backtick markdown, e.g. `InvalidContentEntryDataError`)
     had no styling anywhere in the codebase — not even overflow-wrap. A long
     technical term with no natural break point overflows its line on a
     narrow viewport the same way the h1 fix in global.css addresses for
     headings; :not(pre code) keeps this off the block-level code inside
     .astro-code, which already handles its own wrapping via overflow-x. */
  .article-content :global(code:not(pre code)) {
    overflow-wrap: break-word;
  }

  .article-content :global(.astro-code code) {
    counter-reset: line;
  }

  .article-content :global(.astro-code .line) {
    display: block;
    position: relative;
    counter-increment: line;
    padding-left: calc(var(--spacing) * 4);
    min-height: 1lh;
  }

  .article-content :global(.astro-code .line::before) {
    content: counter(line);
    position: absolute;
    left: 0;
    width: calc(var(--spacing) * 3);
    text-align: right;
    color: #6e7681;
    user-select: none;
  }

  .article-content :global(.astro-code .line.highlighted) {
    background-color: rgb(110 118 129 / 0.15);
  }

  .article-content :global(.astro-code .line.diff.add) {
    background-color: rgb(46 160 67 / 0.15);
  }

  .article-content :global(.astro-code .line.diff.remove) {
    background-color: rgb(248 81 73 / 0.15);
  }
</style>

<script>
  // Copy-to-clipboard button — pure progressive enhancement. Code is
  // already fully readable/selectable without this; the button just
  // becomes clickable once JS is available.
  document.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      ".code-block__copy",
    );
    if (!button) return;

    const code = button.closest(".code-block")?.querySelector("code");
    if (!code) return;

    try {
      await navigator.clipboard.writeText(code.textContent ?? "");
    } catch {
      // Clipboard access can fail (permissions, unsupported browser) —
      // fail quietly rather than leave an unhandled rejection; the code
      // is still fully selectable/copyable by hand either way.
      return;
    }

    const originalLabel = button.textContent;
    button.textContent = "Copied!";
    setTimeout(() => {
      button.textContent = originalLabel;
    }, 2000);
  });
</script>

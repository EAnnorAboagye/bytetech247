---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
---

<BaseLayout
  title={`Privacy Policy — ${siteConfig.name}`}
  description={`${siteConfig.name}'s privacy policy.`}
>
  <h1>Privacy Policy</h1>
  <p>
    This is a placeholder. Replace this page with {siteConfig.name}'s actual
    privacy policy (what data is collected, how it's used, and which third-party
    services are involved) before launch.
  </p>
</BaseLayout>

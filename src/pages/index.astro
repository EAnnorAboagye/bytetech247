---
// Bento hero -> Recent -> per-category sections (build-spec.md Phase 2).
// Trending is explicitly deferred to Phase 13 — not built here.
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Center from "../components/layout/Center.astro";
import Grid from "../components/layout/Grid.astro";
import Stack from "../components/layout/Stack.astro";
import HeroTile from "../components/HeroTile.astro";
import PostCard from "../components/PostCard.astro";
import AdSlot from "../components/AdSlot.astro";
import { CATEGORIES, CATEGORY_HOMEPAGE_AD_SLOT, siteConfig } from "../config";
import { itemListJsonLd, absoluteUrl } from "../lib/json-ld";

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Popular and Recent used to be overlapping windows into the same handful
// of latest posts (Popular = allPosts[1..4], Recent = allPosts[0..5], so
// every "Popular" post was also shown in "Recent" a few inches below it —
// wasted homepage real estate on posts a visitor already scrolled past).
// Treating the homepage as one continuous chronological stream instead —
// hero, then Popular, then Recent picks up exactly where Popular left off
// — means every post shown below the hero is genuinely different from the
// last section.
const [heroPost, ...rest] = allPosts;
// 5, not 4: desktop gives the first Popular card a 2-column featured span
// (see .homepage-secondary-grid's CSS below) inside a fixed 3-column
// desktop grid — 1 double-span card + 4 regular ones is exactly what
// fills 2 full rows with no leftover gap. The 5th card is hidden below
// the desktop breakpoint (same nth-child pattern as .responsive-cap-grid
// elsewhere on this page), so mobile/tablet still show exactly the 4
// cards they always have.
const popularPosts = rest.slice(0, 5);
const recentPosts = rest.slice(5, 11);

// Same reasoning as [category]/[slug].astro's preloadCover: point the
// preload hint at the exact asset HeroTile's own <Picture> requests
// (1200w AVIF, matching HeroTile.astro's widths={[1200]}), not the raw
// source — real Cloudflare Web Analytics RUM data (2026-08-05) showed
// the homepage hero tile as an LCP element with no preload hint at all,
// unlike every article page.
const heroPreload = heroPost
  ? await getImage({
      src: heroPost.data.coverImage,
      width: 1200,
      format: "avif",
    })
  : undefined;

// Describes the hero + Popular + Recent stream together — the one
// genuinely non-overlapping "these N posts, in order" list on this page.
// The per-category sections below repeat many of the same posts under a
// different lens (by category, not by recency), so listing those too would
// just duplicate entries rather than describe anything new.
const streamItemListJsonLd = itemListJsonLd(
  [heroPost, ...popularPosts, ...recentPosts]
    .filter((post): post is NonNullable<typeof post> => Boolean(post))
    .map((post) => absoluteUrl(`/${post.data.category}/${post.id}/`)),
);
---

<BaseLayout jsonLd={streamItemListJsonLd} preloadImage={heroPreload?.src}>
  {
    /* gutter="0" — <main> (BaseLayout) already applies its own
       padding-inline as a safety net for pages that don't wrap in
       <Center>. Center's default gutter would stack on top of that
       rather than replace it, quietly eating ~128px of a 375px phone
       screen (32px main + 32px Center, both sides) for zero visual
       reason. Center's max-width is still worth keeping here. */
  }
  <Center gutter="0">
    <Stack space="12" class="homepage-sections">
      <AdSlot
        adSlot={siteConfig.adSlots.homepageHeader}
        size="banner"
        label="Advertisement"
      />

      <div>
        <h1 class="sr-only">{siteConfig.title}</h1>
        <p class="homepage-intro">
          ByteTech247 delivers expert Dev Tools, automation, and AI productivity
          insights. Get production-ready guides and fixes to optimize your
          workflows.
        </p>
      </div>

      {
        heroPost && (
          <section aria-label="Featured post">
            <HeroTile post={heroPost} />
          </section>
        )
      }

      <AdSlot
        adSlot={siteConfig.adSlots.homepageAfterHero}
        size="rectangle"
        label="Advertisement"
      />

      {
        heroPost && popularPosts.length > 0 && (
          <section aria-label="Popular posts">
            <h2 class="section-heading">Popular</h2>
            <Grid
              minItemWidth="16rem"
              space="4"
              class="homepage-secondary-grid"
            >
              {popularPosts.map((post) => (
                <PostCard post={post} eager />
              ))}
            </Grid>
          </section>
        )
      }

      <AdSlot
        adSlot={siteConfig.adSlots.homepageAfterFeatured}
        size="rectangle"
        label="Advertisement"
      />

      <section aria-label="Recent posts">
        <h2 class="section-heading">Recent</h2>
        {
          recentPosts.length > 0 ? (
            <Grid minItemWidth="18rem" space="4" class="responsive-cap-grid">
              {recentPosts.map((post) => (
                <PostCard post={post} />
              ))}
            </Grid>
          ) : (
            <p>No posts yet. Check back soon.</p>
          )
        }
      </section>

      <AdSlot
        adSlot={siteConfig.adSlots.homepageAfterRecent}
        size="rectangle"
        label="Advertisement"
      />

      {
        CATEGORIES.map((category, index) => {
          // 6 max per section, same as Recent — homepage sections are a
          // preview/entry point, not the full archive. Capped here
          // because this loop previously rendered every single post ever
          // published in that category with no limit at all,
          // unbounded growth on the one page every visitor lands on
          // first. "View all" below is what keeps every post still
          // reachable from here despite the cap.
          const categoryPosts = allPosts
            .filter((post) => post.data.category === category.slug)
            .slice(0, 6);
          const isLast = index === CATEGORIES.length - 1;
          return (
            <>
              <section aria-label={category.name}>
                <h2 class="section-heading">{category.name}</h2>
                {categoryPosts.length > 0 ? (
                  <>
                    <Grid
                      minItemWidth="18rem"
                      space="4"
                      class="responsive-cap-grid"
                    >
                      {categoryPosts.map((post) => (
                        <PostCard post={post} />
                      ))}
                    </Grid>
                    <a href={`/${category.slug}/`} class="homepage-view-all">
                      View all in {category.name} →
                    </a>
                  </>
                ) : (
                  <p>No posts yet in {category.name}.</p>
                )}
              </section>

              <AdSlot
                adSlot={
                  siteConfig.adSlots[CATEGORY_HOMEPAGE_AD_SLOT[category.slug]]
                }
                size="rectangle"
                label="Advertisement"
                class={isLast ? "homepage-last-ad" : undefined}
              />
            </>
          );
        })
      }
    </Stack>
  </Center>
</BaseLayout>

<style>
  .homepage-intro {
    max-width: 40rem;
    margin-top: calc(var(--spacing) * 2);
    color: var(--color-fg-muted);
    font-size: var(--text-lg);
    /* Same "give plain text room to breathe" line-height as .legal
       (global.css) and .article-content — this paragraph never got it,
       so it was stuck on Tailwind's Preflight default of 1.5 while every
       other block of prose on the site reads at 1.7. */
    line-height: 1.7;
  }

  .homepage-secondary-grid {
    margin-top: calc(var(--spacing) * 4);
  }

  /* Six stacked, identically-shaped 3-column grids in a row (Popular,
     Recent, then one per category) reads as one long repeating pattern
     rather than distinct sections. Giving Popular's own first card a
     larger, wider treatment breaks that rhythm right after the hero,
     without touching Recent or the category grids below — those stay
     uniform on purpose, since "here are N more, evenly weighted" is the
     correct shape for a plain list.

     Desktop only, locked to a *fixed* 3 columns rather than this page's
     usual auto-fill/minItemWidth packing — auto-fill's column count
     varies continuously with viewport width (at this page's own 72rem
     max content width it actually lands on 4 columns, not 3), and a
     fluid count can't stay gap-free against a fixed 5-card, one-double-
     span layout at every width. Confirmed live (2026-08-15): the featured
     card's 2-column span plus 4 regular cards left a visible empty cell
     in the grid at browser widths where auto-fill happened to land on 3
     columns. A fixed 3 columns + 5 posts (1 double + 4 single = 6 cells
     exactly) fills both rows with no gap at any desktop width, not just
     the one the bug was noticed at. Mobile/tablet are untouched — they
     never reach this media query, so they keep the original 4-visible-
     card, single-column stack exactly as before. */
  @media (min-width: 64rem) {
    .homepage-secondary-grid {
      grid-template-columns: repeat(3, 1fr) !important;
      /* Default grid behavior stretches every item in a row to match its
         tallest neighbor — with the featured card's 2-column-wide (so
         ~2x taller at the same 16:9 ratio) image sharing row 1 with one
         normal-width card, that stretch left the normal card's own
         body padded out with a large dead void instead of ending at its
         real content height. Confirmed live (2026-08-18) via screenshot.
         align-items: start lets each card size to its own content and
         sit at the top of its grid cell instead — the row-1 neighbor
         now just ends where its text ends, no forced empty space inside
         the card itself. */
      align-items: start;
    }

    .homepage-secondary-grid > :global(.post-card-wrapper:nth-child(n + 5)) {
      display: block;
    }

    .homepage-secondary-grid > :global(.post-card-wrapper:first-child) {
      grid-column: span 2;
    }

    .homepage-secondary-grid
      > :global(.post-card-wrapper:first-child .post-card__title) {
      font-size: var(--text-xl);
    }
  }

  /* 5th Popular card stays desktop-only — hidden below 64rem so mobile
     and tablet keep showing exactly the 4 cards they always have. */
  .homepage-secondary-grid > :global(.post-card-wrapper:nth-child(n + 5)) {
    display: none;
  }

  .section-heading {
    font-size: var(--text-2xl);
    margin-bottom: calc(var(--spacing) * 4);
    color: var(--color-fg);
  }

  .homepage-view-all {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    margin-top: calc(var(--spacing) * 3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .homepage-view-all:hover {
    text-decoration: underline;
  }

  /*
   * Recent and each category grid render up to 6 posts in the static
   * HTML (so the full set exists for crawlers/SEO and desktop readers),
   * but only the first 4 should actually show on mobile/tablet —
   * requested 2026-08-11. :global() is required here: this class is
   * applied via Grid.astro's `class` prop, so the actual element it
   * lands on is rendered by Grid.astro's own template, not this page's
   * — Astro's scoped-style attribute only ever lands on elements a
   * component writes directly in its own template (confirmed live
   * elsewhere in this codebase: PostCard.astro's :global(.post-card)
   * comment has the same root cause). Reverted back to visible at
   * >=64rem, the same breakpoint TOCSidebar.astro already uses to mean
   * "desktop, not tablet."
   */
  .responsive-cap-grid > :global(.post-card-wrapper:nth-child(n + 5)) {
    display: none;
  }

  @media (min-width: 64rem) {
    .responsive-cap-grid > :global(.post-card-wrapper:nth-child(n + 5)) {
      display: block;
    }
  }

  /* The last category's trailing ad slot sits directly above the
     footer rather than another content section — a hair more breathing
     room than the Stack gap alone gives every other inter-section gap. */
  :global(.homepage-last-ad) {
    margin-bottom: calc(var(--spacing) * 2);
  }

  /* 6rem between major sections (hero / recent / each category) reads
     fine on desktop but is a lot of empty scrolling on a phone — tighten
     it below the tablet breakpoint rather than carrying the same value
     down to every screen size. */
  @media (max-width: 48rem) {
    :global(.homepage-sections) {
      --stack-space: calc(var(--spacing) * 8);
    }
  }
</style>

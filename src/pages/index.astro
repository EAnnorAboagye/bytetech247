---
// Bento hero -> Recent -> per-category sections (build-spec.md Phase 2).
// Trending is explicitly deferred to Phase 13 — not built here.
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Center from "../components/layout/Center.astro";
import Grid from "../components/layout/Grid.astro";
import Stack from "../components/layout/Stack.astro";
import HeroTile from "../components/HeroTile.astro";
import PostCard from "../components/PostCard.astro";
import AdSlot from "../components/AdSlot.astro";
import { CATEGORIES, CATEGORY_HOMEPAGE_AD_SLOT, siteConfig } from "../config";
import { itemListJsonLd, absoluteUrl } from "../lib/json-ld";

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const [heroPost, ...secondaryPosts] = allPosts;
const recentPosts = allPosts.slice(0, 6);

// Same reasoning as [category]/[slug].astro's preloadCover: point the
// preload hint at the exact asset HeroTile's own <Picture> requests
// (1200w AVIF, matching HeroTile.astro's widths={[1200]}), not the raw
// source — real Cloudflare Web Analytics RUM data (2026-08-05) showed
// the homepage hero tile as an LCP element with no preload hint at all,
// unlike every article page.
const heroPreload = heroPost
  ? await getImage({
      src: heroPost.data.coverImage,
      width: 1200,
      format: "avif",
    })
  : undefined;

// Recent already covers heroPost (recentPosts[0] === heroPost) and is the
// one section on this page that's genuinely "a list of these N posts" in
// the ItemList sense — the per-category sections below repeat many of the
// same posts, so listing those too would just duplicate entries rather
// than describe anything new.
const recentItemListJsonLd = itemListJsonLd(
  recentPosts.map((post) => absoluteUrl(`/${post.data.category}/${post.id}/`)),
);
---

<BaseLayout jsonLd={recentItemListJsonLd} preloadImage={heroPreload?.src}>
  {
    /* gutter="0" — <main> (BaseLayout) already applies its own
       padding-inline as a safety net for pages that don't wrap in
       <Center>. Center's default gutter would stack on top of that
       rather than replace it, quietly eating ~128px of a 375px phone
       screen (32px main + 32px Center, both sides) for zero visual
       reason. Center's max-width is still worth keeping here. */
  }
  <Center gutter="0">
    <Stack space="12" class="homepage-sections">
      <AdSlot
        slot={siteConfig.adSlots.homepageHeader}
        minHeight="100px"
        label="Advertisement"
      />

      <div>
        <h1 class="sr-only">{siteConfig.title}</h1>
        <p class="homepage-intro">
          ByteTech247 delivers expert Dev Tools, automation, and AI productivity
          insights. Get production-ready guides and fixes to optimize your
          workflows.
        </p>
      </div>

      {
        heroPost && (
          <section aria-label="Featured post">
            <HeroTile post={heroPost} />
          </section>
        )
      }

      <AdSlot
        slot={siteConfig.adSlots.homepageAfterHero}
        minHeight="250px"
        label="Advertisement"
      />

      {
        heroPost && secondaryPosts.length > 0 && (
          <section aria-label="Popular posts">
            <h2 class="section-heading">Popular</h2>
            <Grid
              minItemWidth="16rem"
              space="4"
              class="homepage-secondary-grid"
            >
              {secondaryPosts.slice(0, 4).map((post) => (
                <PostCard post={post} eager />
              ))}
            </Grid>
          </section>
        )
      }

      <AdSlot
        slot={siteConfig.adSlots.homepageAfterFeatured}
        minHeight="250px"
        label="Advertisement"
      />

      <section aria-label="Recent posts">
        <h2 class="section-heading">Recent</h2>
        {
          recentPosts.length > 0 ? (
            <Grid minItemWidth="18rem" space="4" class="responsive-cap-grid">
              {recentPosts.map((post) => (
                <PostCard post={post} />
              ))}
            </Grid>
          ) : (
            <p>No posts yet. Check back soon.</p>
          )
        }
      </section>

      <AdSlot
        slot={siteConfig.adSlots.homepageAfterRecent}
        minHeight="250px"
        label="Advertisement"
      />

      {
        CATEGORIES.map((category, index) => {
          // 6 max per section, same as Recent — homepage sections are a
          // preview/entry point, not the full archive. Capped here
          // because this loop previously rendered every single post ever
          // published in that category with no limit at all,
          // unbounded growth on the one page every visitor lands on
          // first. "View all" below is what keeps every post still
          // reachable from here despite the cap.
          const categoryPosts = allPosts
            .filter((post) => post.data.category === category.slug)
            .slice(0, 6);
          const isLast = index === CATEGORIES.length - 1;
          return (
            <>
              <section aria-label={category.name}>
                <h2 class="section-heading">{category.name}</h2>
                {categoryPosts.length > 0 ? (
                  <>
                    <Grid
                      minItemWidth="18rem"
                      space="4"
                      class="responsive-cap-grid"
                    >
                      {categoryPosts.map((post) => (
                        <PostCard post={post} />
                      ))}
                    </Grid>
                    <a href={`/${category.slug}/`} class="homepage-view-all">
                      View all in {category.name} →
                    </a>
                  </>
                ) : (
                  <p>No posts yet in {category.name}.</p>
                )}
              </section>

              <AdSlot
                slot={
                  siteConfig.adSlots[CATEGORY_HOMEPAGE_AD_SLOT[category.slug]]
                }
                minHeight="250px"
                label="Advertisement"
                class={isLast ? "homepage-last-ad" : undefined}
              />
            </>
          );
        })
      }
    </Stack>
  </Center>
</BaseLayout>

<style>
  .homepage-intro {
    max-width: 40rem;
    color: var(--color-fg-muted);
    font-size: var(--text-lg);
  }

  .homepage-secondary-grid {
    margin-top: calc(var(--spacing) * 4);
  }

  .section-heading {
    font-size: var(--text-2xl);
    margin-bottom: calc(var(--spacing) * 4);
    color: var(--color-fg);
  }

  .homepage-view-all {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    margin-top: calc(var(--spacing) * 3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .homepage-view-all:hover {
    text-decoration: underline;
  }

  /*
   * Recent and each category grid render up to 6 posts in the static
   * HTML (so the full set exists for crawlers/SEO and desktop readers),
   * but only the first 4 should actually show on mobile/tablet —
   * requested 2026-08-11. :global() is required here: this class is
   * applied via Grid.astro's `class` prop, so the actual element it
   * lands on is rendered by Grid.astro's own template, not this page's
   * — Astro's scoped-style attribute only ever lands on elements a
   * component writes directly in its own template (confirmed live
   * elsewhere in this codebase: PostCard.astro's :global(.post-card)
   * comment has the same root cause). Reverted back to visible at
   * >=64rem, the same breakpoint TOCSidebar.astro already uses to mean
   * "desktop, not tablet."
   */
  .responsive-cap-grid > :global(.post-card-wrapper:nth-child(n + 5)) {
    display: none;
  }

  @media (min-width: 64rem) {
    .responsive-cap-grid > :global(.post-card-wrapper:nth-child(n + 5)) {
      display: block;
    }
  }

  /* The last category's trailing ad slot sits directly above the
     footer rather than another content section — a hair more breathing
     room than the Stack gap alone gives every other inter-section gap. */
  :global(.homepage-last-ad) {
    margin-bottom: calc(var(--spacing) * 2);
  }

  /* 6rem between major sections (hero / recent / each category) reads
     fine on desktop but is a lot of empty scrolling on a phone — tighten
     it below the tablet breakpoint rather than carrying the same value
     down to every screen size. */
  @media (max-width: 48rem) {
    :global(.homepage-sections) {
      --stack-space: calc(var(--spacing) * 8);
    }
  }
</style>

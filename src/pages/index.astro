---
// Bento hero -> Recent -> per-category sections (build-spec.md Phase 2).
// Trending is explicitly deferred to Phase 13 — not built here.
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Center from "../components/layout/Center.astro";
import Grid from "../components/layout/Grid.astro";
import Stack from "../components/layout/Stack.astro";
import HeroTile from "../components/HeroTile.astro";
import PostCard from "../components/PostCard.astro";
import { CATEGORIES, siteConfig } from "../config";
import { itemListJsonLd, absoluteUrl } from "../lib/json-ld";

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const [heroPost, ...secondaryPosts] = allPosts;
const recentPosts = allPosts.slice(0, 6);

// Recent already covers heroPost (recentPosts[0] === heroPost) and is the
// one section on this page that's genuinely "a list of these N posts" in
// the ItemList sense — the per-category sections below repeat many of the
// same posts, so listing those too would just duplicate entries rather
// than describe anything new.
const recentItemListJsonLd = itemListJsonLd(
  recentPosts.map((post) => absoluteUrl(`/${post.data.category}/${post.id}/`)),
);
---

<BaseLayout jsonLd={recentItemListJsonLd}>
  {
    /* gutter="0" — <main> (BaseLayout) already applies its own
       padding-inline as a safety net for pages that don't wrap in
       <Center>. Center's default gutter would stack on top of that
       rather than replace it, quietly eating ~128px of a 375px phone
       screen (32px main + 32px Center, both sides) for zero visual
       reason. Center's max-width is still worth keeping here. */
  }
  <Center gutter="0">
    <Stack space="12" class="homepage-sections">
      <div>
        <h1 class="sr-only">{siteConfig.title}</h1>
        <p class="homepage-intro">
          ByteTech247 delivers expert Dev Tools, automation, and AI productivity
          insights. Get production-ready guides and fixes to optimize your
          workflows.
        </p>
      </div>

      {
        heroPost && (
          <section aria-label="Featured post">
            <HeroTile post={heroPost} />
            {secondaryPosts.length > 0 && (
              <Grid
                minItemWidth="16rem"
                space="4"
                class="homepage-secondary-grid"
              >
                {secondaryPosts.slice(0, 4).map((post) => (
                  <PostCard post={post} eager />
                ))}
              </Grid>
            )}
          </section>
        )
      }

      <section aria-label="Recent posts">
        <h2 class="section-heading">Recent</h2>
        {
          recentPosts.length > 0 ? (
            <Grid minItemWidth="18rem" space="4">
              {recentPosts.map((post) => (
                <PostCard post={post} />
              ))}
            </Grid>
          ) : (
            <p>No posts yet. Check back soon.</p>
          )
        }
      </section>

      {
        CATEGORIES.map((category) => {
          const categoryPosts = allPosts.filter(
            (post) => post.data.category === category.slug,
          );
          return (
            <section aria-label={category.name}>
              <h2 class="section-heading">{category.name}</h2>
              {categoryPosts.length > 0 ? (
                <Grid minItemWidth="18rem" space="4">
                  {categoryPosts.map((post) => (
                    <PostCard post={post} />
                  ))}
                </Grid>
              ) : (
                <p>No posts yet in {category.name}.</p>
              )}
            </section>
          );
        })
      }
    </Stack>
  </Center>
</BaseLayout>

<style>
  .homepage-intro {
    max-width: 40rem;
    color: var(--color-fg-muted);
    font-size: var(--text-lg);
  }

  .homepage-secondary-grid {
    margin-top: calc(var(--spacing) * 4);
  }

  .section-heading {
    font-size: var(--text-2xl);
    margin-bottom: calc(var(--spacing) * 4);
    color: var(--color-fg);
  }

  /* 6rem between major sections (hero / recent / each category) reads
     fine on desktop but is a lot of empty scrolling on a phone — tighten
     it below the tablet breakpoint rather than carrying the same value
     down to every screen size. */
  @media (max-width: 48rem) {
    :global(.homepage-sections) {
      --stack-space: calc(var(--spacing) * 8);
    }
  }
</style>

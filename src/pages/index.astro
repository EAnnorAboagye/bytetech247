---
// Homepage (2026-08 redesign): masthead -> hero row (+ Latest list) ->
// free tools strip -> Most read -> Recent (list) -> per-category sections.
// Trending is explicitly deferred to Phase 13 — not built here.
import { getCollection } from "astro:content";
import { getImage, Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Center from "../components/layout/Center.astro";
import HeroTile from "../components/HeroTile.astro";
import PostCard from "../components/PostCard.astro";
import RecentList from "../components/RecentList.astro";
import ToolsStrip from "../components/ToolsStrip.astro";
import HomeMasthead from "../components/HomeMasthead.astro";
import AdSlot from "../components/AdSlot.astro";
import {
  CATEGORIES,
  CATEGORY_HOMEPAGE_AD_SLOT,
  getCategoryDescription,
  getCategoryName,
  siteConfig,
} from "../config";
import { calculateReadingTime } from "../lib/reading-time";
import { itemListJsonLd, absoluteUrl } from "../lib/json-ld";

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const [heroPost, ...rest] = allPosts;
// Latest recaps the freshest posts right beside the hero — independent of
// Popular/Recent below it, which is why it can (and does) overlap with
// them: it's a compact "what just went up" widget, not another
// non-overlapping window into the stream.
const latestPosts = rest.slice(0, 5);
// 3, not 5 — the redesign drops Popular's old double-span featured
// treatment (that special treatment moved to the hero row itself), so
// Popular is now a plain, evenly-weighted 3-card row.
const popularPosts = rest.slice(0, 3);
const recentPosts = rest.slice(3, 9);

// Same reasoning as [category]/[slug].astro's preloadCover: point the
// preload hint at the exact asset HeroTile's own <Picture> requests
// (1200w AVIF, matching HeroTile.astro's widths={[1200]}), not the raw
// source — real Cloudflare Web Analytics RUM data (2026-08-05) showed
// the homepage hero tile as an LCP element with no preload hint at all,
// unlike every article page.
const heroPreload = heroPost
  ? await getImage({
      src: heroPost.data.coverImage,
      width: 1200,
      format: "avif",
    })
  : undefined;

// Describes the hero + Popular + Recent stream together — the one
// genuinely non-overlapping "these N posts, in order" list on this page.
// The per-category sections below repeat many of the same posts under a
// different lens (by category, not by recency), so listing those too would
// just duplicate entries rather than describe anything new.
const streamItemListJsonLd = itemListJsonLd(
  [heroPost, ...popularPosts, ...recentPosts]
    .filter((post): post is NonNullable<typeof post> => Boolean(post))
    .map((post) => absoluteUrl(`/${post.data.category}/${post.id}/`)),
);

const categorySections = CATEGORIES.map((category) => {
  // Lead card + 3 compact thumbnail rows — 4 posts total, not the old
  // 6-post grid. Homepage sections are a preview/entry point, not the
  // full archive; "View all" is what keeps every other post reachable.
  const categoryPosts = allPosts
    .filter((post) => post.data.category === category.slug)
    .slice(0, 4);
  return { category, lead: categoryPosts[0], items: categoryPosts.slice(1) };
});

const formatShortDate = (date: Date) =>
  date
    .toLocaleDateString("en-US", {
      month: "short",
      day: "2-digit",
      timeZone: "UTC",
    })
    .toUpperCase();
---

<BaseLayout
  jsonLd={streamItemListJsonLd}
  preloadImage={heroPreload?.src}
  preloadMastheadFonts
>
  <Center gutter="0">
    <HomeMasthead />

    <AdSlot
      adSlot={siteConfig.adSlots.homepageHeader}
      size="banner"
      label="Advertisement"
    />

    {
      heroPost && (
        <section aria-label="Featured post" class="hero-row">
          <HeroTile post={heroPost} />
          <aside class="hero-row__latest" aria-label="Latest posts">
            <div class="hero-row__latest-header">
              <h2 class="hero-row__latest-heading">Latest</h2>
              <a href="/archive/" class="hero-row__latest-archive">
                Archive →
              </a>
            </div>
            <ul class="hero-row__latest-list">
              {latestPosts.map((post) => (
                <li data-category={post.data.category}>
                  <a
                    href={`/${post.data.category}/${post.id}/`}
                    class="hero-row__latest-link"
                  >
                    <span class="hero-row__latest-meta">
                      <span class="hero-row__latest-dot" aria-hidden="true" />
                      {getCategoryName(post.data.category)} ·{" "}
                      {formatShortDate(post.data.date)}
                    </span>
                    <h3 class="hero-row__latest-title">{post.data.title}</h3>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        </section>
      )
    }

    <ToolsStrip />

    <AdSlot
      adSlot={siteConfig.adSlots.homepageAfterHero}
      size="rectangle"
      label="Advertisement"
    />

    {
      popularPosts.length > 0 && (
        <section aria-label="Popular posts" class="homepage-section">
          <h2 class="section-heading">Most read</h2>
          <div class="most-read-grid">
            {popularPosts.map((post) => (
              <PostCard post={post} eager />
            ))}
          </div>
        </section>
      )
    }

    <section aria-label="Recent posts" class="homepage-section">
      <div class="homepage-section__header">
        <h2 class="section-heading">Recent</h2>
        <a href="/archive/" class="homepage-view-all">All posts →</a>
      </div>
      {
        recentPosts.length > 0 ? (
          <RecentList posts={recentPosts} />
        ) : (
          <p>No posts yet. Check back soon.</p>
        )
      }
    </section>

    <AdSlot
      adSlot={siteConfig.adSlots.homepageAfterRecent}
      size="rectangle"
      label="Advertisement"
    />

    {
      categorySections.map(({ category, lead, items }, index) => {
        const isLast = index === categorySections.length - 1;
        return (
          <>
            <section
              aria-label={category.name}
              class="category-section"
              data-category={category.slug}
            >
              <div class="category-section__header">
                <div>
                  <h2 class="category-section__heading">{category.name}</h2>
                  <p class="category-section__description">
                    {getCategoryDescription(category.slug)}
                  </p>
                </div>
                <a
                  href={`/${category.slug}/`}
                  class="category-section__view-all"
                >
                  View all →
                </a>
              </div>

              {lead ? (
                <div class="category-section__body">
                  <a
                    href={`/${category.slug}/${lead.id}/`}
                    class="category-section__lead"
                  >
                    <Picture
                      src={lead.data.coverImage}
                      alt={lead.data.coverImageAlt}
                      widths={[640]}
                      formats={["avif", "webp"]}
                      loading="lazy"
                      class="category-section__lead-cover"
                    />
                    <h3 class="category-section__lead-title">
                      {lead.data.title}
                    </h3>
                    <p class="category-section__lead-dek">
                      {lead.data.description}
                    </p>
                    <p class="category-section__lead-meta">
                      {formatShortDate(lead.data.date)} ·{" "}
                      {calculateReadingTime(lead.body ?? "")} min read
                    </p>
                  </a>
                  <ul class="category-section__list">
                    {items.map((post) => (
                      <li>
                        <a
                          href={`/${category.slug}/${post.id}/`}
                          class="category-section__row"
                        >
                          <Picture
                            src={post.data.coverImage}
                            alt={post.data.coverImageAlt}
                            widths={[176]}
                            formats={["avif", "webp"]}
                            loading="lazy"
                            class="category-section__row-thumb"
                          />
                          <span>
                            <span class="category-section__row-title">
                              {post.data.title}
                            </span>
                            <span class="category-section__row-meta">
                              {formatShortDate(post.data.date)} ·{" "}
                              {calculateReadingTime(post.body ?? "")} min
                            </span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <p>No posts yet in {category.name}.</p>
              )}
            </section>

            <AdSlot
              adSlot={
                siteConfig.adSlots[CATEGORY_HOMEPAGE_AD_SLOT[category.slug]]
              }
              size="rectangle"
              label="Advertisement"
              class={isLast ? "homepage-last-ad" : undefined}
            />
          </>
        );
      })
    }
  </Center>
</BaseLayout>

<style>
  /* Uniform vertical rhythm around every AdSlot on this page — replaces
     the Stack primitive's old blanket gap now that top-level sections
     each carry their own padding instead. Also satisfies the 36px
     margin-top the per-category slot needs. */
  :global(.center) > :global(.ad-slot) {
    margin: calc(var(--spacing) * 4.5) 0;
  }

  .hero-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--spacing) * 5);
    padding: calc(var(--spacing) * 4.5) 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  @media (min-width: 64rem) {
    .hero-row {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }

    /* min-width: 0 is load-bearing here — grid items default to
       min-width: auto, so this column would otherwise refuse to shrink
       below its own min-content, break the 1.4fr/1fr fraction math, and
       force horizontal scroll below roughly 1200px. */
    .hero-row > :global(.hero-tile),
    .hero-row__latest {
      min-width: 0;
    }
  }

  .hero-row__latest-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: calc(var(--spacing) * 1.375);
    border-bottom: 2px solid var(--color-fg);
  }

  .hero-row__latest-heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-row__latest-archive {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--color-accent);
    text-decoration: none;
  }

  .hero-row__latest-archive:hover {
    text-decoration: underline;
  }

  .hero-row__latest-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-row__latest-link {
    display: block;
    padding: calc(var(--spacing) * 2) 0;
    border-bottom: 1px solid var(--color-hairline);
    color: inherit;
    text-decoration: none;
  }

  .hero-row__latest-meta {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 1.125);
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }

  .hero-row__latest-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--card-accent, var(--color-accent));
    flex-shrink: 0;
  }

  .hero-row__latest-title {
    margin: calc(var(--spacing) * 1) 0 0;
    font-family: var(--font-serif);
    font-weight: 700;
    letter-spacing: normal;
    font-size: 1rem;
    line-height: 1.32;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }

  .hero-row__latest-link:hover .hero-row__latest-title {
    color: var(--card-accent, var(--color-accent));
  }

  .homepage-section {
    padding: calc(var(--spacing) * 5.5) 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .homepage-section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: calc(var(--spacing) * 0.75);
    padding-bottom: calc(var(--spacing) * 1.375);
    border-bottom: 2px solid var(--color-fg);
  }

  .homepage-section > .section-heading {
    padding-bottom: calc(var(--spacing) * 1.375);
    border-bottom: 2px solid var(--color-fg);
  }

  .section-heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 calc(var(--spacing) * 2.75);
    color: var(--color-fg);
  }

  .homepage-section__header .section-heading {
    margin: 0;
    padding: 0;
    border: none;
  }

  .most-read-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--spacing) * 2.75);
  }

  @media (min-width: 40rem) {
    .most-read-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .most-read-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .homepage-view-all {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .homepage-view-all:hover {
    text-decoration: underline;
  }

  .category-section {
    padding: calc(var(--spacing) * 6) 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .category-section__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: calc(var(--spacing) * 3.5);
    margin-bottom: calc(var(--spacing) * 3.25);
    padding-bottom: calc(var(--spacing) * 1.625);
    border-bottom: 2px solid var(--card-accent, var(--color-accent));
  }

  .category-section__heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--card-accent, var(--color-accent));
  }

  .category-section__description {
    margin: calc(var(--spacing) * 1.25) 0 0;
    max-width: 64ch;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-fg-muted);
  }

  .category-section__view-all {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .category-section__view-all:hover {
    color: var(--card-accent, var(--color-accent));
  }

  .category-section__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--spacing) * 4.5);
  }

  @media (min-width: 64rem) {
    .category-section__body {
      grid-template-columns: 1.15fr 1fr;
    }

    /* Same load-bearing min-width: 0 as the hero row above — this pairing
       has the identical shape (a fixed-ratio grid with a nowrap-metadata
       child) and hits the same horizontal-scroll wall without it. */
    .category-section__lead,
    .category-section__list {
      min-width: 0;
    }
  }

  .category-section__lead {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .category-section__lead-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.625rem;
    border: 1px solid var(--color-hairline);
  }

  .category-section__lead-title {
    display: block;
    margin: calc(var(--spacing) * 2) 0 0;
    font-family: var(--font-serif);
    font-weight: 700;
    letter-spacing: -0.01em;
    font-size: 1.3125rem;
    line-height: 1.2;
    text-wrap: balance;
    overflow-wrap: anywhere;
    color: var(--color-fg);
  }

  .category-section__lead:hover .category-section__lead-title {
    color: var(--card-accent, var(--color-accent));
  }

  .category-section__lead-dek {
    margin: calc(var(--spacing) * 1.25) 0 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-fg-muted);
  }

  .category-section__lead-meta {
    margin: calc(var(--spacing) * 1.625) 0 0;
    font-family: var(--font-display);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
  }

  .category-section__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .category-section__row {
    display: flex;
    gap: calc(var(--spacing) * 2);
    padding: calc(var(--spacing) * 1.875) 0;
    border-bottom: 1px solid var(--color-hairline);
    color: inherit;
    text-decoration: none;
  }

  .category-section__row-thumb {
    width: 88px;
    flex-shrink: 0;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.4375rem;
    border: 1px solid var(--color-hairline);
  }

  .category-section__row-title {
    display: block;
    font-family: var(--font-serif);
    font-weight: 700;
    letter-spacing: normal;
    font-size: 0.9375rem;
    line-height: 1.3;
    text-wrap: pretty;
    overflow-wrap: anywhere;
    color: var(--color-fg);
  }

  .category-section__row:hover .category-section__row-title {
    color: var(--card-accent, var(--color-accent));
  }

  .category-section__row-meta {
    display: block;
    margin-top: calc(var(--spacing) * 1);
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }

  /* The last category's trailing ad slot sits directly above the
     footer rather than another content section — a hair more breathing
     room than the page's own bottom padding alone gives every other
     inter-section gap. */
  :global(.homepage-last-ad) {
    margin-bottom: calc(var(--spacing) * 2);
  }

  /* Section padding reads fine on desktop but is a lot of empty
     scrolling on a phone — tighten it below the tablet breakpoint rather
     than carrying the same value down to every screen size. */
  @media (max-width: 48rem) {
    .homepage-section,
    .category-section {
      padding-block: calc(var(--spacing) * 4);
    }
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
---

<BaseLayout
  title={`Affiliate & Advertising Disclosure — ${siteConfig.name}`}
  description={`How ${siteConfig.name} handles affiliate links and sponsored content.`}
>
  <h1>Affiliate &amp; Advertising Disclosure</h1>
  <p>
    This is a placeholder. {siteConfig.name} does not currently run affiliate links
    or advertising. This page will be filled in with the real disclosure policy before
    either is enabled (see build-spec.md Phase 14) — per-post disclosure callouts
    on affiliate/sponsored content link back here.
  </p>
</BaseLayout>

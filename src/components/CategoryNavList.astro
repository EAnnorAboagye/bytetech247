---
// Rendered twice by Header.astro (mobile disclosure + desktop nav) so both
// copies stay in the DOM for CSS-only responsive show/hide — every link is
// a real <a href> in both, so nothing depends on which one is visible.
import { CATEGORIES, getCategoryName, type CategorySlug } from "../config";

interface Props {
  topTagsByCategory: Record<CategorySlug, string[]>;
  variant?: "horizontal" | "vertical";
}

const { topTagsByCategory, variant = "vertical" } = Astro.props;
---

<ul class:list={["category-nav-list", `category-nav-list--${variant}`]}>
  {
    CATEGORIES.map((category) => (
      <li>
        <details>
          <summary>
            <a href={`/${category.slug}/`}>{category.name}</a>
          </summary>
          <ul class="category-nav-list__panel">
            {topTagsByCategory[category.slug].map((tag) => (
              <li>
                <span class="category-nav-list__tag">{tag}</span>
              </li>
            ))}
            <li>
              <a href={`/${category.slug}/`}>
                View all in {getCategoryName(category.slug)}
              </a>
            </li>
          </ul>
        </details>
      </li>
    ))
  }
</ul>

<style>
  .category-nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .category-nav-list > li > details > summary {
    cursor: pointer;
    list-style: none;
  }

  .category-nav-list > li > details > summary::-webkit-details-marker {
    display: none;
  }

  .category-nav-list a {
    color: var(--color-fg);
    text-decoration: none;
  }

  .category-nav-list details[open] > summary a {
    color: var(--color-accent);
  }

  .category-nav-list__panel {
    list-style: none;
    margin: 0;
    padding: var(--spacing);
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 0.5);
  }

  .category-nav-list__tag {
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }

  /* Desktop: categories sit in a horizontal row, each panel drops down
     below its own summary instead of pushing content down inline. */
  .category-nav-list--horizontal {
    flex-direction: row;
    align-items: center;
  }

  .category-nav-list--horizontal > li {
    position: relative;
  }

  .category-nav-list--horizontal .category-nav-list__panel {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 12rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    z-index: 10;
  }
</style>

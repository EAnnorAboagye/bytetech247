---
// build-spec.md §10, restyled per the 2026-08 redesign: a brand row that
// carries no navigation (logo + BLOG chip on the left, search + theme
// actions on the right) plus a second-row category strip underneath it
// (Home, each category's own dropdown, Tools, Archive) that replaces the
// old single-row "logo + nav + actions" bar. The strip is real <a href>
// markup, not JS-revealed — crawlable, and an improvement on the old
// hover mega-panel some crawlers reach less reliably.
//
// Bar order, left to right: logo, mobile menu toggle (mobile/tablet/narrow
// desktop, below 64rem — hidden above it, where the strip renders instead),
// search, dark/light toggle. 64rem (not the old 72rem) is the strip's own
// breakpoint now — sized to what the scrolling strip actually needs to
// read comfortably, not a conventional phone/tablet/desktop split.
import { getCollection } from "astro:content";
import { siteConfig } from "../config";
import { getTopTagsByCategory } from "../lib/taxonomy";
import PrimaryNav from "./PrimaryNav.astro";

const posts = await getCollection("blog");
const topTagsByCategory = getTopTagsByCategory(posts);
const currentPath = Astro.url.pathname;
---

<div class="site-header__sentinel" aria-hidden="true"></div>
<header class="site-header">
  <div class="site-header__bar">
    <a href="/" class="site-header__logo">
      <img
        src="/logo-mark.svg"
        alt={siteConfig.name}
        width="30"
        height="30"
        class="site-header__logo-mark"
      />
      <span class="site-header__wordmark">
        {
          /* aria-hidden, not a second copy of the name for sighted users
             only — the image's own alt above already gives this link its
             full accessible name ("ByteTech247"). Without this, a screen
             reader announces it twice ("ByteTech247, ByteTech247") on
             literally every page, since both the alt text and this text
             node concatenate into the same <a>'s accessible name. */
        }
        <span aria-hidden="true">{siteConfig.name}</span>
        {
          /* The BLOG chip is what distinguishes this masthead from the
             news site's own NEWS chip at a glance — the two properties
             otherwise share the same logo system. aria-hidden for the
             same reason as the wordmark span above: "ByteTech247, Blog"
             would be a strange, redundant accessible name for a link
             whose destination is just the homepage. */
        }
        <span class="site-header__chip" aria-hidden="true">Blog</span>
      </span>
    </a>

    <div class="site-header__spacer"></div>

    <details class="site-header__mobile-toggle">
      <summary aria-label="Open menu">
        <span aria-hidden="true">&#9776;</span>
      </summary>
      <nav aria-label="Primary" class="site-header__mobile-nav">
        <PrimaryNav
          topTagsByCategory={topTagsByCategory}
          variant="vertical"
          currentPath={currentPath}
        />
      </nav>
    </details>

    <div class="site-header__actions">
      <button
        type="button"
        class="site-header__action site-header__search"
        data-command-palette-trigger
        aria-label="Search (Ctrl+K)"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="15"
          height="15"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="site-header__search-label">Search</span>
        <span class="site-header__search-chip" aria-hidden="true">⌘K</span>
      </button>
      <button
        type="button"
        class="site-header__action site-header__theme-toggle"
        data-theme-toggle
        aria-label="Toggle dark mode"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="site-header__theme-icon site-header__theme-icon--sun"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <line x1="12" y1="2" x2="12" y2="4"></line>
          <line x1="12" y1="20" x2="12" y2="22"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="2" y1="12" x2="4" y2="12"></line>
          <line x1="20" y1="12" x2="22" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="site-header__theme-icon site-header__theme-icon--moon"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav aria-label="Primary" class="site-header__strip">
    <PrimaryNav
      topTagsByCategory={topTagsByCategory}
      variant="horizontal"
      currentPath={currentPath}
    />
  </nav>
</header>

<style>
  /* 1px, zero-height — exists only so the IntersectionObserver below has
     something at the very top of the page to watch. Once it scrolls out
     of view, the header has moved away from the page's natural top edge
     and earns a border/shadow to read as "floating" rather than flush. */
  .site-header__sentinel {
    position: absolute;
    top: 0;
    height: 1px;
    width: 100%;
    pointer-events: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid transparent;
    background-color: var(--color-bg);
    transition:
      border-color var(--duration-base) var(--ease-out-expo),
      box-shadow var(--duration-base) var(--ease-out-expo);
  }

  .site-header--elevated {
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-card);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    max-width: 72rem;
    height: 56px;
    margin-inline: auto;
    padding-inline: calc(var(--spacing) * 4);
  }

  @media (min-width: 40rem) {
    .site-header__bar {
      height: 60px;
    }
  }

  @media (min-width: 64rem) {
    .site-header__bar {
      height: 64px;
    }
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 1.5);
    min-height: 24px;
    color: var(--color-fg);
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-header__logo-mark {
    border-radius: 0.375rem;
    flex-shrink: 0;
  }

  .site-header__wordmark {
    display: flex;
    align-items: baseline;
    gap: calc(var(--spacing) * 1);
  }

  .site-header__wordmark > span:first-child {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  /* The chip that distinguishes this masthead from the sibling news
     property's own NEWS chip at a glance. */
  .site-header__chip {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 3px;
    padding: 2px 5px;
    text-transform: uppercase;
  }

  .site-header__spacer {
    flex: 1;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    flex-shrink: 0;
  }

  .site-header__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--spacing) * 5);
    height: calc(var(--spacing) * 5);
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: none;
    color: var(--color-fg-muted);
  }

  .site-header__action:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .site-header__search-label,
  .site-header__search-chip {
    display: none;
  }

  /* Both icons occupy the same spot and cross-fade/rotate between each
     other based on the current theme, rather than swapping instantly —
     which icon is showing doubles as the state indicator itself (sun in
     light mode, moon in dark mode), matching the pattern already used for
     hover/focus transitions elsewhere (--duration-base/--ease-out-expo). */
  .site-header__theme-toggle {
    position: relative;
  }

  .site-header__theme-icon {
    position: absolute;
    transition:
      opacity var(--duration-base) var(--ease-out-expo),
      transform var(--duration-base) var(--ease-out-expo);
  }

  .site-header__theme-icon--moon {
    opacity: 0;
    transform: rotate(-90deg);
  }

  :root[data-theme="dark"] .site-header__theme-icon--sun {
    opacity: 0;
    transform: rotate(90deg);
  }

  :root[data-theme="dark"] .site-header__theme-icon--moon {
    opacity: 1;
    transform: rotate(0deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__theme-icon {
      transition: none;
    }
  }

  .site-header__mobile-toggle {
    display: block;
  }

  .site-header__mobile-toggle > summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--spacing) * 5);
    height: calc(var(--spacing) * 5);
    cursor: pointer;
    list-style: none;
  }

  .site-header__mobile-toggle > summary::-webkit-details-marker {
    display: none;
  }

  .site-header__mobile-nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100vh - 100%);
    overflow-y: auto;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: calc(var(--spacing) * 4);
  }

  /* The category strip — the second row, full width under the brand row,
     separated by a hairline. Real <a> links, overflow-x: auto so it
     scrolls rather than wraps at a narrow desktop width. Hidden below
     64rem, where the mobile disclosure carries the same links instead. */
  .site-header__strip {
    display: none;
  }

  @media (min-width: 64rem) {
    .site-header__mobile-toggle {
      display: none;
    }

    .site-header__strip {
      display: block;
      border-top: 1px solid var(--color-hairline);
      overflow-x: auto;
    }

    .site-header__strip :global(.primary-nav) {
      max-width: 72rem;
      margin-inline: auto;
      padding-inline: calc(var(--spacing) * 4);
    }

    /* Labeled search (icon + "Search" + a ⌘K chip) replaces the bare
       icon button once there's room for it — a labeled control reads as
       an invitation where a bare icon reads as decoration. Same shell as
       the theme toggle beside it: hairline border, 8px radius,
       --color-bg-subtle fill, not the icon-only actions' circular
       transparent button. */
    .site-header__search {
      width: auto;
      height: 38px;
      padding-inline: calc(var(--spacing) * 1.5);
      gap: calc(var(--spacing) * 1.25);
      border-radius: 8px;
      background-color: var(--color-bg-subtle);
    }

    .site-header__search-label {
      display: inline;
      font-family: var(--font-display);
      font-size: var(--text-xs);
    }

    .site-header__search-chip {
      display: inline-flex;
      align-items: center;
      border: 1px solid var(--color-border);
      border-radius: 4px;
      padding: 1px 5px;
      font-family: var(--font-display);
      font-size: 10px;
    }

    .site-header__theme-toggle {
      width: 38px;
      height: 38px;
      border-radius: 8px;
      background-color: var(--color-bg-subtle);
    }
  }

  @media (max-width: 63.9375rem) {
    /* Touch targets: Apple/Google both recommend a 44px minimum hit area.
       Desktop's 40px action buttons stay as-is (mouse pointer) — this
       only widens the tappable area below the strip's own breakpoint,
       via padding rather than changing the visual size. That range now
       includes real touch tablets (iPad-class devices sit well under
       1024px), not just phones, so this is a correctness fix for them
       too, not just unchanged behavior carried to a new number. */
    .site-header__action {
      width: 44px;
      height: 44px;
    }

    /* Pre-existing narrow-viewport overflow, confirmed live at 375px: two
       44px touch targets plus their gap and this row's own margin-left
       ran 7px past the actual viewport width, forcing a page-wide
       horizontal scrollbar on every page (this header renders on all of
       them). Tightening just the two mobile-only spacing values below
       removes the overflow without touching the 40px desktop sizing
       (only .site-header__action's WIDTH changes there, not this gap). */
    .site-header__actions {
      gap: calc(var(--spacing) * 1);
    }

    .site-header__mobile-toggle > summary {
      width: 44px;
      height: 44px;
    }

    .site-header__mobile-nav :global(.primary-nav__link),
    .site-header__mobile-nav :global(.primary-nav > li > details > summary),
    .site-header__mobile-nav :global(.primary-nav__panel a) {
      min-height: 44px;
    }
  }
</style>

<script>
  // Document-delegated (not attached to a specific button element) so it
  // keeps working after Astro view-transition navigations re-render the
  // header — and since this script module is shared across every page,
  // it only ever registers the listener once, not once per navigation.
  document.addEventListener("click", (event) => {
    const toggle = (event.target as HTMLElement).closest("[data-theme-toggle]");
    if (!toggle) return;

    const current = document.documentElement.getAttribute("data-theme");
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
  });

  // Every <details> dropdown *in the header* (nav category/privacy panels,
  // the mobile menu toggle) closes when the visitor clicks anywhere
  // outside it, or presses Escape — native <details> doesn't do either of
  // these on its own, which otherwise forces a second click on the
  // trigger just to dismiss an open panel. Scoped to .site-header
  // specifically — these are transient overlay menus, unlike the
  // article's inline table-of-contents <details> (TOCSidebar.astro),
  // which a reader expects to stay open while they keep reading/clicking
  // around the page.
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    for (const details of document.querySelectorAll(
      ".site-header details[open]",
    )) {
      if (!details.contains(target)) {
        details.removeAttribute("open");
      }
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const details of document.querySelectorAll(
      ".site-header details[open]",
    )) {
      details.removeAttribute("open");
    }
  });

  // Toggles the header's floating border/shadow once the page has
  // scrolled past the 1px sentinel at the very top — an
  // IntersectionObserver instead of a scroll listener for the same
  // reason TOCSidebar.astro's scroll-spy uses one (no per-frame layout
  // work). Re-armed on every view-transition navigation, same pattern as
  // that scroll-spy, since the sentinel element itself is replaced.
  let headerElevationObserver: IntersectionObserver | null = null;

  function setupHeaderElevation() {
    headerElevationObserver?.disconnect();

    const sentinel = document.querySelector(".site-header__sentinel");
    const header = document.querySelector(".site-header");
    if (!sentinel || !header) return;

    headerElevationObserver = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle("site-header--elevated", !entry.isIntersecting);
      },
      { threshold: 0 },
    );
    headerElevationObserver.observe(sentinel);
  }

  document.addEventListener("astro:page-load", setupHeaderElevation);

  // Hover-to-open for the horizontal (desktop) strip's category
  // dropdowns — layered on top of <details>'s native click/keyboard
  // toggle, which stays fully intact, so keyboard users are unaffected
  // and touch devices (which can't hover) still open panels the normal
  // way, via a tap. Gated on (hover: hover) and (pointer: fine): the
  // standard way to detect "this is a real mouse," rather than a
  // screen-width guess — a touchscreen laptop docked with a mouse still
  // gets hover, a touch-only tablet at a desktop width never does.
  // Listens on each <li> (which contains both the summary and the
  // absolutely-positioned panel under it), not the summary alone, so
  // moving the pointer from trigger to panel never registers as "left"
  // in between.
  const hoverCapable = window.matchMedia("(hover: hover) and (pointer: fine)");
  const hoverNavCloseTimers: WeakMap<
    Element,
    ReturnType<typeof setTimeout>
  > = new WeakMap();

  function setupHoverNav() {
    if (!hoverCapable.matches) return;

    for (const li of document.querySelectorAll(
      ".primary-nav--horizontal > li",
    )) {
      const details = li.querySelector(":scope > details");
      const summary = details?.querySelector(":scope > summary");
      if (!details || !summary) continue;

      li.addEventListener("mouseenter", () => {
        const pending = hoverNavCloseTimers.get(li);
        if (pending) clearTimeout(pending);
        details.setAttribute("open", "");
      });

      li.addEventListener("mouseleave", () => {
        const timer = setTimeout(() => details.removeAttribute("open"), 150);
        hoverNavCloseTimers.set(li, timer);
      });

      // A real mouse click is preceded by its own mousemove/mouseenter,
      // which the listener above already used to force this open — so by
      // the time the click itself lands, <details>'s native toggle-on-
      // click sees "already open" and closes it right back, one gesture
      // after opening it (confirmed live via Playwright, which — unlike
      // a synthetic .click() with no mouse movement — simulates the real
      // hover-then-click sequence a physical mouse produces). Preventing
      // default only when already open cancels just that native toggle;
      // a click while genuinely closed (keyboard, touch, or mouse after
      // mouseleave already closed it) still opens normally.
      summary.addEventListener("click", (event) => {
        if (details.hasAttribute("open")) event.preventDefault();
      });
    }
  }

  document.addEventListener("astro:page-load", setupHoverNav);
</script>

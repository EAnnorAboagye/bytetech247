---
// build-spec.md §10 — identical on every route. Static (not sticky) by
// default, per the guardrail: sticky-on-scroll is an explicit Phase 13
// upgrade, not something to default into.
//
// Bar order, left to right: logo, mobile menu toggle (mobile/tablet/narrow
// desktop, below 72rem — hidden above it, where PrimaryNav's horizontal
// variant renders inline instead), primary nav (≥72rem only), search,
// dark/light toggle. The 72rem threshold isn't a conventional
// phone/tablet/desktop split — it's sized to what the horizontal nav
// actually needs to render without wrapping (see PrimaryNav.astro and
// build-spec.md §10), which happens to land past a typical tablet width.
import { getCollection } from "astro:content";
import { siteConfig } from "../config";
import { getTopTagsByCategory } from "../lib/taxonomy";
import PrimaryNav from "./PrimaryNav.astro";

const posts = await getCollection("blog");
const topTagsByCategory = getTopTagsByCategory(posts);
---

<div class="site-header__sentinel" aria-hidden="true"></div>
<header class="site-header">
  <div class="site-header__bar">
    <a href="/" class="site-header__logo">
      <img
        src="/logo-mark.svg"
        alt=""
        width="28"
        height="28"
        class="site-header__logo-mark"
      />
      {siteConfig.name}
    </a>

    <details class="site-header__mobile-toggle">
      <summary aria-label="Open menu">
        <span aria-hidden="true">&#9776;</span>
      </summary>
      <nav aria-label="Primary" class="site-header__mobile-nav">
        <PrimaryNav topTagsByCategory={topTagsByCategory} variant="vertical" />
      </nav>
    </details>

    <nav aria-label="Primary" class="site-header__desktop-nav">
      <PrimaryNav topTagsByCategory={topTagsByCategory} variant="horizontal" />
    </nav>

    <div class="site-header__actions">
      <button
        type="button"
        class="site-header__action"
        data-command-palette-trigger
        aria-label="Search (Ctrl+K)"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
      <button
        type="button"
        class="site-header__action site-header__theme-toggle"
        data-theme-toggle
        aria-label="Toggle dark mode"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="site-header__theme-icon site-header__theme-icon--sun"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <line x1="12" y1="2" x2="12" y2="4"></line>
          <line x1="12" y1="20" x2="12" y2="22"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="2" y1="12" x2="4" y2="12"></line>
          <line x1="20" y1="12" x2="22" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="site-header__theme-icon site-header__theme-icon--moon"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  /* 1px, zero-height — exists only so the IntersectionObserver below has
     something at the very top of the page to watch. Once it scrolls out
     of view, the header has moved away from the page's natural top edge
     and earns a border/shadow to read as "floating" rather than flush. */
  .site-header__sentinel {
    position: absolute;
    top: 0;
    height: 1px;
    width: 100%;
    pointer-events: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid transparent;
    background-color: var(--color-bg);
    transition:
      border-color var(--duration-base) var(--ease-out-expo),
      box-shadow var(--duration-base) var(--ease-out-expo);
  }

  .site-header--elevated {
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-card);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--spacing) calc(var(--spacing) * 4);
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 1.5);
    min-height: 24px;
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-fg);
    text-decoration: none;
    margin-right: auto;
  }

  .site-header__logo-mark {
    border-radius: 0.375rem;
    flex-shrink: 0;
  }

  .site-header__actions {
    display: flex;
    gap: calc(var(--spacing) * 2);
    margin-left: calc(var(--spacing) * 3);
  }

  .site-header__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--spacing) * 5);
    height: calc(var(--spacing) * 5);
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: none;
    color: var(--color-fg-muted);
  }

  .site-header__action:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Both icons occupy the same spot and cross-fade/rotate between each
     other based on the current theme, rather than swapping instantly —
     which icon is showing doubles as the state indicator itself (sun in
     light mode, moon in dark mode), matching the pattern already used for
     hover/focus transitions elsewhere (--duration-base/--ease-out-expo). */
  .site-header__theme-toggle {
    position: relative;
  }

  .site-header__theme-icon {
    position: absolute;
    transition:
      opacity var(--duration-base) var(--ease-out-expo),
      transform var(--duration-base) var(--ease-out-expo);
  }

  .site-header__theme-icon--moon {
    opacity: 0;
    transform: rotate(-90deg);
  }

  :root[data-theme="dark"] .site-header__theme-icon--sun {
    opacity: 0;
    transform: rotate(90deg);
  }

  :root[data-theme="dark"] .site-header__theme-icon--moon {
    opacity: 1;
    transform: rotate(0deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__theme-icon {
      transition: none;
    }
  }

  .site-header__mobile-toggle {
    display: none;
  }

  .site-header__mobile-toggle > summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--spacing) * 5);
    height: calc(var(--spacing) * 5);
    cursor: pointer;
    list-style: none;
  }

  .site-header__mobile-toggle > summary::-webkit-details-marker {
    display: none;
  }

  .site-header__mobile-nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100vh - 100%);
    overflow-y: auto;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: calc(var(--spacing) * 4);
  }

  @media (max-width: 72rem) {
    .site-header__mobile-toggle {
      display: block;
    }

    .site-header__desktop-nav {
      display: none;
    }

    /* Touch targets: Apple/Google both recommend a 44px minimum hit area.
       Desktop's 40px action buttons stay as-is (mouse pointer, and the
       user wants that look preserved) — this only widens the tappable
       area below 72rem, via padding rather than changing the visual size.
       That range now includes real touch tablets (iPad-class devices sit
       well under 1152px), not just phones, so this is a correctness fix
       for them too, not just unchanged behavior carried to a new number. */
    .site-header__action {
      width: 44px;
      height: 44px;
    }

    /* Pre-existing narrow-viewport overflow, confirmed live at 375px: two
       44px touch targets plus their gap and this row's own margin-left
       ran 7px past the actual viewport width, forcing a page-wide
       horizontal scrollbar on every page (this header renders on all of
       them). Tightening just the two mobile-only spacing values below
       removes the overflow without touching the 40px desktop sizing
       (only .site-header__action's WIDTH changes there, not this
       margin/gap). */
    .site-header__actions {
      gap: calc(var(--spacing) * 1);
      margin-left: var(--spacing);
    }

    .site-header__mobile-toggle > summary {
      width: 44px;
      height: 44px;
    }

    .site-header__mobile-nav :global(.primary-nav__link),
    .site-header__mobile-nav :global(.primary-nav > li > details > summary),
    .site-header__mobile-nav :global(.primary-nav__panel a) {
      min-height: 44px;
    }
  }
</style>

<script>
  // Document-delegated (not attached to a specific button element) so it
  // keeps working after Astro view-transition navigations re-render the
  // header — and since this script module is shared across every page,
  // it only ever registers the listener once, not once per navigation.
  document.addEventListener("click", (event) => {
    const toggle = (event.target as HTMLElement).closest("[data-theme-toggle]");
    if (!toggle) return;

    const current = document.documentElement.getAttribute("data-theme");
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
  });

  // Every <details> dropdown *in the header* (nav category/privacy panels,
  // the mobile menu toggle) closes when the visitor clicks anywhere
  // outside it, or presses Escape — native <details> doesn't do either of
  // these on its own, which otherwise forces a second click on the
  // trigger just to dismiss an open panel. Scoped to .site-header
  // specifically — these are transient overlay menus, unlike the
  // article's inline table-of-contents <details> (TOCSidebar.astro),
  // which a reader expects to stay open while they keep reading/clicking
  // around the page.
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    for (const details of document.querySelectorAll(
      ".site-header details[open]",
    )) {
      if (!details.contains(target)) {
        details.removeAttribute("open");
      }
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const details of document.querySelectorAll(
      ".site-header details[open]",
    )) {
      details.removeAttribute("open");
    }
  });

  // Toggles the header's floating border/shadow once the page has
  // scrolled past the 1px sentinel at the very top — an
  // IntersectionObserver instead of a scroll listener for the same
  // reason TOCSidebar.astro's scroll-spy uses one (no per-frame layout
  // work). Re-armed on every view-transition navigation, same pattern as
  // that scroll-spy, since the sentinel element itself is replaced.
  let headerElevationObserver: IntersectionObserver | null = null;

  function setupHeaderElevation() {
    headerElevationObserver?.disconnect();

    const sentinel = document.querySelector(".site-header__sentinel");
    const header = document.querySelector(".site-header");
    if (!sentinel || !header) return;

    headerElevationObserver = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle("site-header--elevated", !entry.isIntersecting);
      },
      { threshold: 0 },
    );
    headerElevationObserver.observe(sentinel);
  }

  document.addEventListener("astro:page-load", setupHeaderElevation);
</script>

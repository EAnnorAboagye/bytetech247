---
// Reusable share menu — used on both PostCard.astro (homepage/archive grid)
// and the article template ([category]/[slug].astro). Brand marks are real
// simple-icons path data (facebook/x/whatsapp), same verified-icon approach
// as Footer.astro; email and copy-link use plain generic glyphs since
// neither is a brand mark.
//
// Built as a <details>/<summary> dropdown, matching the site's existing
// pattern (Header.astro nav panels, TOCSidebar.astro) rather than a custom
// popover implementation. The outside-click/Escape-close script below is
// scoped to `.share-buttons details[open]` and lives in this component's
// own <script> tag — Astro dedupes a component's script to one copy per
// page regardless of how many ShareButtons instances render (e.g. one per
// PostCard in a grid), so this stays correct without any global wiring.
import { siFacebook, siWhatsapp, siX } from "simple-icons";

interface Props {
  url: string;
  title: string;
  class?: string;
}

const { url, title, class: className } = Astro.props;

const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
const xHref = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`;
const emailHref = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`;
---

<div class:list={["share-buttons", className]}>
  <details class="share-buttons__menu">
    <summary class="share-buttons__trigger" aria-label="Share this post">
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="18" cy="5" r="2.5"></circle>
        <circle cx="6" cy="12" r="2.5"></circle>
        <circle cx="18" cy="19" r="2.5"></circle>
        <path d="M8.2 10.8 15.8 6.4M8.2 13.2l7.6 4.4"></path>
      </svg>
      <span class="share-buttons__label">Share</span>
    </summary>
    <ul class="share-buttons__list">
      <li>
        <a
          href={facebookHref}
          target="_blank"
          rel="noopener noreferrer"
          class="share-buttons__link"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
            ><path d={siFacebook.path} fill="currentColor"></path></svg
          >
          Facebook
        </a>
      </li>
      <li>
        <a
          href={xHref}
          target="_blank"
          rel="noopener noreferrer"
          class="share-buttons__link"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
            ><path d={siX.path} fill="currentColor"></path></svg
          >
          X
        </a>
      </li>
      <li>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="share-buttons__link"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
            ><path d={siWhatsapp.path} fill="currentColor"></path></svg
          >
          WhatsApp
        </a>
      </li>
      <li>
        <a href={emailHref} class="share-buttons__link">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2.5" y="4.5" width="19" height="15" rx="2"></rect>
            <path d="m3.5 6 8.5 6.5L20.5 6"></path>
          </svg>
          Email
        </a>
      </li>
      <li>
        <button
          type="button"
          class="share-buttons__link share-buttons__copy"
          data-copy-link
          data-url={url}
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M9.5 14.5 14.5 9.5M11 7l1.3-1.3a3.2 3.2 0 0 1 4.5 4.5L15.5 11.5M13 17l-1.3 1.3a3.2 3.2 0 0 1-4.5-4.5L8.5 12.5"
            ></path>
          </svg>
          <span data-copy-label>Copy link</span>
        </button>
      </li>
    </ul>
  </details>
</div>

<style>
  .share-buttons {
    position: relative;
  }

  .share-buttons__menu {
    position: relative;
  }

  .share-buttons__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--spacing) * 1);
    min-height: 24px;
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 1.5);
    color: var(--color-fg-muted);
    cursor: pointer;
    list-style: none;
  }

  .share-buttons__trigger::-webkit-details-marker {
    display: none;
  }

  .share-buttons__trigger:hover {
    color: var(--color-accent);
  }

  .share-buttons__label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .share-buttons__list {
    position: absolute;
    z-index: 20;
    top: calc(100% + 4px);
    right: 0;
    margin: 0;
    padding: calc(var(--spacing) * 1);
    list-style: none;
    min-width: 11rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }

  .share-buttons__link {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    width: 100%;
    min-height: 44px;
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 1.5);
    border: none;
    background: none;
    color: var(--color-fg);
    font-size: var(--text-sm);
    text-decoration: none;
    text-align: left;
    border-radius: 4px;
    cursor: pointer;
  }

  .share-buttons__link:hover {
    background-color: var(--color-bg-subtle);
    color: var(--color-accent);
  }

  .share-buttons__link svg {
    flex-shrink: 0;
  }
</style>

<script>
  // Copy-link feedback — event delegation so this works for every
  // ShareButtons instance on the page (e.g. one per PostCard in a grid)
  // without attaching a listener per button.
  document.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-copy-link]",
    );
    if (!button) return;

    const url = button.dataset.url;
    if (!url) return;

    try {
      await navigator.clipboard.writeText(url);
      const label = button.querySelector("[data-copy-label]");
      if (label) {
        const original = label.textContent;
        label.textContent = "Copied!";
        setTimeout(() => {
          label.textContent = original;
        }, 1500);
      }
    } catch {
      // Clipboard API unavailable (non-secure context, permission denied) —
      // the link itself is still reachable via every other share option, so
      // fail quietly rather than show an error for a non-critical action.
    }
  });

  // Same outside-click/Escape-close convention as Header.astro's nav
  // panels — scoped to .share-buttons specifically so it doesn't affect
  // the article's inline TOC <details> (TOCSidebar.astro), which should
  // stay open while reading.
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    for (const details of document.querySelectorAll(
      ".share-buttons details[open]",
    )) {
      if (!details.contains(target)) {
        details.removeAttribute("open");
      }
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const details of document.querySelectorAll(
      ".share-buttons details[open]",
    )) {
      details.removeAttribute("open");
    }
  });
</script>

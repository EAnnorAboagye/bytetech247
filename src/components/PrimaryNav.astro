---
// Rendered twice by Header.astro (mobile disclosure + desktop category
// strip) — both copies stay in the DOM for CSS-only responsive show/hide,
// but they're no longer identical (see variant check below), so nothing
// else depends on which one is visible beyond that split.
//
// Order (left to right / top to bottom): Home, each category (own
// tag-dropdown), Tools (own dropdown), Archive — then, vertical
// (mobile/tablet hamburger) only — About, Contact, Privacy (dropdown
// listing every legal page). The horizontal (desktop) strip deliberately
// stops at Archive: About/Contact/every legal page are already one click
// away in the footer and already listed in the command palette's
// static-page jump list (CommandPalette.astro), so the wide-viewport strip
// doesn't need to duplicate them. Mobile keeps the full list since there's
// no width constraint forcing a choice.
// The category name and "Privacy" label in <summary> are deliberately
// plain text, not a nested <a> — nesting an interactive link inside the
// native disclosure trigger is a real accessibility anti-pattern
// (ambiguous activation behavior for assistive tech, flagged by axe-core's
// nested-interactive rule). Each panel's own links are the one real,
// unambiguous way in — that's why "Privacy Policy" appears inside the
// Privacy panel rather than the summary itself linking there.
//
// Every <details> here closes on outside click / Escape via the shared
// script in Header.astro, not locally — one listener for every dropdown
// on the page (including the mobile menu toggle) rather than one per
// instance.
import {
  CATEGORIES,
  getCategoryName,
  TOOLS,
  type CategorySlug,
} from "../config";
import { slugifyTag } from "../lib/taxonomy";

interface Props {
  topTagsByCategory: Record<CategorySlug, string[]>;
  variant?: "horizontal" | "vertical";
  currentPath?: string;
}

const { topTagsByCategory, variant = "vertical", currentPath = "" } =
  Astro.props;

// Exact-match only (no partial/nested-route matching) — the strip marks
// Home or a category active only when a visitor is actually on that
// archive page, not on every post filed under it.
const isActive = (href: string) => currentPath === href;

const legalLinks = [
  { label: "Privacy Policy", href: "/privacy/" },
  { label: "Terms & Conditions", href: "/terms/" },
  {
    label: "Affiliate/Advertising Disclosure",
    href: "/affiliate-disclosure/",
  },
  { label: "Editorial Policy", href: "/editorial-policy/" },
];
---

<ul class:list={["primary-nav", `primary-nav--${variant}`]}>
  <li>
    <a
      href="/"
      class="primary-nav__link"
      aria-current={isActive("/") ? "page" : undefined}
    >
      Home
    </a>
  </li>

  {
    CATEGORIES.map((category) => (
      <li data-category={category.slug}>
        <details class="primary-nav__dropdown">
          <summary aria-current={isActive(`/${category.slug}/`) ? "page" : undefined}>
            {category.name} <span aria-hidden="true">&#9662;</span>
          </summary>
          <div class="primary-nav__panel">
            <ul class="primary-nav__tags">
              {topTagsByCategory[category.slug].map((tag) => (
                <li>
                  <a href={`/tag/${slugifyTag(tag)}/`} class="primary-nav__tag">
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
            <a href={`/${category.slug}/`} class="primary-nav__view-all">
              View all in {getCategoryName(category.slug)}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </details>
      </li>
    ))
  }

  <li>
    <details class="primary-nav__dropdown">
      <summary>
        Tools <span aria-hidden="true">&#9662;</span>
      </summary>
      <div class="primary-nav__panel">
        <ul class="primary-nav__tags">
          {
            TOOLS.map((tool) => (
              <li>
                <a href={`/tools/${tool.slug}/`} class="primary-nav__tag">
                  {tool.name}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/tools/" class="primary-nav__view-all">
          View all Tools
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </details>
  </li>

  {
    variant === "horizontal" && (
      <>
        <li class="primary-nav__spacer" aria-hidden="true" />
        <li>
          <a href="/archive/" class="primary-nav__link">
            Archive
          </a>
        </li>
      </>
    )
  }

  {
    variant === "vertical" && (
      <>
        <li>
          <a href="/archive/" class="primary-nav__link">
            Archive
          </a>
        </li>
        <li>
          <a href="/about/" class="primary-nav__link">
            About
          </a>
        </li>
        <li>
          <a href="/contact/" class="primary-nav__link">
            Contact
          </a>
        </li>

        <li>
          <details class="primary-nav__dropdown">
            <summary>
              Privacy <span aria-hidden="true">&#9662;</span>
            </summary>
            <ul class="primary-nav__panel">
              {legalLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      </>
    )
  }
</ul>

<style>
  .primary-nav {
    display: flex;
    flex-direction: column;
    gap: var(--spacing);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav__link,
  .primary-nav > li > details > summary {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 0.5);
    min-height: 24px;
    padding: calc(var(--spacing) * 0.5) 0;
    cursor: pointer;
    list-style: none;
    color: var(--color-fg);
  }

  .primary-nav__link {
    text-decoration: none;
    cursor: default;
  }

  .primary-nav > li > details > summary::-webkit-details-marker {
    display: none;
  }

  .primary-nav a {
    color: var(--color-fg);
    text-decoration: none;
  }

  .primary-nav__link:hover,
  .primary-nav a:hover {
    color: var(--color-accent);
  }

  .primary-nav details[open] > summary {
    color: var(--color-accent);
  }

  /* The panel wrapping element is a <ul> for the vertical/mobile Privacy
     dropdown (legalLinks, still a flat link list) but a <div> for every
     category dropdown (tag grid + a distinct "view all" CTA below it) —
     list-style/margin/padding/flex-column here has to work as a no-op on
     the <div> case and a real list-reset on the <ul> case, which it does:
     none of these properties depend on the element actually being a list. */
  .primary-nav__panel {
    list-style: none;
    margin: 0;
    padding: var(--spacing);
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 0.5);
  }

  .primary-nav__panel a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: calc(var(--spacing) * 0.5) 0;
  }

  .primary-nav__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 0.5);
  }

  .primary-nav__tag {
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }

  /* More specific than the generic ".primary-nav__panel a" rule above
     (two classes vs. one class + one type selector would normally lose —
     qualifying with the parent class here is what makes this one win). */
  .primary-nav__panel .primary-nav__view-all {
    justify-content: space-between;
    gap: calc(var(--spacing) * 1);
    margin-top: calc(var(--spacing) * 1);
    padding-top: calc(var(--spacing) * 1.5);
    border-top: 1px solid var(--color-hairline);
    font-weight: 600;
    color: var(--color-accent);
  }

  /* Horizontal (desktop, >=64rem) — the category strip row under the
     header's brand row. Each item is its own uppercase mono tab with a
     2px transparent bottom border that fills with that item's own accent
     on hover/open (categories) or stays permanently filled when the
     visitor is actually on that page (Home/Archive's aria-current). The
     strip scrolls (overflow-x: auto on the wrapping <nav>, set in
     Header.astro) rather than wraps at narrow desktop widths. */
  .primary-nav--horizontal {
    flex-direction: row;
    align-items: center;
    gap: 2px;
    white-space: nowrap;
  }

  .primary-nav--horizontal > li {
    position: relative;
    flex-shrink: 0;
  }

  .primary-nav--horizontal > .primary-nav__spacer {
    flex: 1;
    min-width: calc(var(--spacing) * 4);
  }

  .primary-nav--horizontal .primary-nav__link,
  .primary-nav--horizontal > li > details > summary {
    padding: 11px 14px 9px;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    border-bottom: 2px solid transparent;
  }

  .primary-nav--horizontal .primary-nav__link:hover,
  .primary-nav--horizontal > li > details > summary:hover {
    color: var(--card-accent, var(--color-accent));
    border-bottom-color: var(--card-accent, var(--color-accent));
  }

  .primary-nav--horizontal details[open] > summary {
    color: var(--card-accent, var(--color-accent));
    border-bottom-color: var(--card-accent, var(--color-accent));
  }

  .primary-nav--horizontal .primary-nav__link[aria-current="page"] {
    color: var(--color-fg);
    border-bottom-color: var(--color-accent);
  }

  /* Mega-menu panel: a wide card instead of the mobile accordion's plain
     stacked list, with the category's own accent color (--card-accent,
     set globally per [data-category], see global.css) as a top border so
     each dropdown reads as belonging to that category at a glance. The
     open/close instant is <details> toggling display, which a CSS
     transition can't animate — an animation (not a transition) still
     plays every time the element actually becomes visible, which is what
     gives this its fade/slide-in on open. */
  .primary-nav--horizontal .primary-nav__panel {
    position: absolute;
    top: calc(100% + calc(var(--spacing) * 1));
    left: 0;
    min-width: 20rem;
    padding: calc(var(--spacing) * 3);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--card-accent, var(--color-accent));
    border-radius: 0.75rem;
    box-shadow: var(--shadow-card-hover);
    z-index: 10;
    animation: primary-nav-panel-in var(--duration-base) var(--ease-out-expo);
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-nav--horizontal .primary-nav__panel {
      animation: none;
    }
  }

  @keyframes primary-nav-panel-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Tag list becomes a two-column grid here — "horizontal," not the
     mobile accordion's single vertical column — so up to 5 tags read as
     a scannable block instead of a tall single-file list. */
  .primary-nav--horizontal .primary-nav__tags {
    display: grid;
    grid-template-columns: repeat(2, minmax(7rem, 1fr));
    gap: calc(var(--spacing) * 0.5) calc(var(--spacing) * 3);
  }
</style>

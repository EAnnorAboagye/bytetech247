---
// coverImage has been required by the Phase 3 schema since content.config.ts
// was written — this renders it as the card's 16:9 image (build-spec.md
// Phase 10 grid-card placement). Every card image is offscreen/below the
// fold somewhere on every page that uses PostCard, so lazy-loading here is
// correct; the one LCP-critical cover (article hero) is handled separately
// in [category]/[slug].astro with loading="eager" + preload.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";
import { getCategoryName } from "../config";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const categoryName = getCategoryName(post.data.category);
const href = `/${post.data.category}/${post.id}/`;
---

<Card as="article" padding="none" class="post-card">
  <a href={href} class="post-card__link">
    <Image
      src={post.data.coverImage}
      alt={post.data.coverImageAlt}
      width={640}
      height={360}
      loading="lazy"
      class="post-card__cover"
    />
    <div class="post-card__body">
      <p class="post-card__category">{categoryName}</p>
      <h3 class="post-card__title">{post.data.title}</h3>
      <p class="post-card__description">{post.data.description}</p>
      <p class="post-card__date">
        <time datetime={post.data.date.toISOString()}>
          {
            post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })
          }
        </time>
      </p>
    </div>
  </a>
</Card>

<style>
  .post-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .post-card__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .post-card__body {
    padding: calc(var(--spacing) * 4);
    display: flex;
    flex-direction: column;
    gap: var(--spacing);
  }

  .post-card__category {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-card__title {
    font-size: var(--text-lg);
    color: var(--color-fg);
  }

  .post-card__description {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .post-card__date {
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }
</style>

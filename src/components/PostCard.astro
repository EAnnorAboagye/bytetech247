---
// coverImage has been required by the Phase 3 schema since content.config.ts
// was written — this renders it as the card's 16:9 image (build-spec.md
// Phase 10 grid-card placement), the exact same asset used as the article's
// own hero image (src/pages/[category]/[slug].astro) — never a different,
// homepage-only thumbnail.
//
// `eager` defaults to false (lazy) because most PostCard instances really
// are below the fold (Recent, per-category sections, category/tag/archive
// pages). It is NOT true for every usage though — real Cloudflare Web
// Analytics RUM data (2026-08-05) showed a homepage post-card image as the
// actual LCP element for real visitors, at up to 4,932ms, because the
// homepage's secondary grid (the row of cards directly under the hero) sits
// close enough to the fold on real viewports that lazy-loading delayed the
// fetch past when it was needed. index.astro passes eager={true} for that
// grid specifically; every other PostCard usage keeps the lazy default.
//
// Title and description are clamped to a fixed number of lines (not left to
// grow with content) so cards in the same row stay level regardless of how
// long any one post's title/description is — "Read more" is the one
// consistent way into the full article, not a variable-height blob of text.
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";
import { getCategoryName } from "../config";

interface Props {
  post: CollectionEntry<"blog">;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const categoryName = getCategoryName(post.data.category);
const href = `/${post.data.category}/${post.id}/`;
---

<div class="post-card-wrapper" data-category={post.data.category}>
  <Card as="article" padding="none" class="post-card">
    <a href={href} class="post-card__link">
      <div class="post-card__cover-wrap">
        <Picture
          src={post.data.coverImage}
          alt={post.data.coverImageAlt}
          widths={[640]}
          formats={["avif", "webp"]}
          loading={eager ? "eager" : "lazy"}
          class="post-card__cover"
        />
        <span class="post-card__badge">{categoryName}</span>
      </div>
      <div class="post-card__body">
        <h3 class="post-card__title">{post.data.title}</h3>
        <p class="post-card__description">{post.data.description}</p>
        <p class="post-card__meta">
          <time datetime={post.data.date.toISOString()}>
            {
              post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
                timeZone: "UTC",
              })
            }
          </time>
          <span class="post-card__read-more">Read more →</span>
        </p>
      </div>
    </a>
  </Card>
</div>

<style>
  .post-card-wrapper {
    height: 100%;
  }

  /*
   * :global() — .post-card is the class Card.astro (a *child* component)
   * actually renders its <article> with, via the `class` prop. Astro's
   * scoped-style attribute only ever lands on elements a component
   * writes directly in its own template, never on a child component's
   * internal output — confirmed live: an unscoped rule here matched
   * nothing at all (no data-astro-cid on that <article>), so both of
   * these silently never applied. Same reasoning as the :global() usage
   * on .post-share / .article-content h2 etc. in [slug].astro.
   */
  :global(.post-card) {
    height: 100%;
    position: relative;
  }

  /* A 3px category-colored top edge — the fastest way to tell categories
     apart in a mixed grid (Recent, related, search) before reading any
     text. Drawn as a pseudo-element, not a border, so it doesn't disturb
     the card's existing 1px border-radius corners. */
  :global(.post-card::before) {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background-color: var(--card-accent, var(--color-accent));
  }

  .post-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .post-card__cover-wrap {
    position: relative;
  }

  .post-card__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* A solid category-colored badge directly on the thumbnail — every cover
     image on this site shares the same dark terminal-screenshot template,
     so nothing in the image itself tells two cards apart at a glance. This
     puts the one piece of real per-card color (the category accent,
     already used for the thin top edge) where the eye actually lands
     first, instead of only in a small text label below the fold of the
     image. */
  .post-card__badge {
    position: absolute;
    top: calc(var(--spacing) * 1.5);
    left: calc(var(--spacing) * 1.5);
    padding: calc(var(--spacing) * 0.5) calc(var(--spacing) * 1.25);
    border-radius: 999px;
    background-color: var(--card-accent, var(--color-accent));
    color: var(--color-accent-fg);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
  }

  .post-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 1.5);
    padding: calc(var(--spacing) * 3);
  }

  .post-card__title {
    font-size: var(--text-lg);
    font-family: var(--font-serif);
    letter-spacing: normal;
    color: var(--color-fg);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__description {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__meta {
    margin-top: auto;
    padding-top: calc(var(--spacing) * 1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing);
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }

  .post-card__read-more {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .post-card__link:hover .post-card__read-more {
    text-decoration: underline;
  }
</style>

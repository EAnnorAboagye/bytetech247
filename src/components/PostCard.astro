---
// Cover image is intentionally not rendered yet — `coverImage` doesn't
// exist in the frontmatter schema until Phase 3. Add the <Figure>/image
// slot here once that field lands, rather than referencing a field that
// doesn't exist yet.
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";
import { getCategoryName } from "../config";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const categoryName = getCategoryName(post.data.category);
const href = `/${post.data.category}/${post.id}/`;
---

<Card as="article" padding="none" class="post-card">
  <a href={href} class="post-card__link">
    <div class="post-card__body">
      <p class="post-card__category">{categoryName}</p>
      <h3 class="post-card__title">{post.data.title}</h3>
      <p class="post-card__description">{post.data.description}</p>
      <p class="post-card__date">
        <time datetime={post.data.date.toISOString()}>
          {
            post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })
          }
        </time>
      </p>
    </div>
  </a>
</Card>

<style>
  .post-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .post-card__body {
    padding: calc(var(--spacing) * 4);
    display: flex;
    flex-direction: column;
    gap: var(--spacing);
  }

  .post-card__category {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-card__title {
    font-size: var(--text-lg);
    color: var(--color-fg);
  }

  .post-card__description {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .post-card__date {
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }
</style>

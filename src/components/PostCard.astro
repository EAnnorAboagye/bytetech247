---
// coverImage has been required by the Phase 3 schema since content.config.ts
// was written — this renders it as the card's 16:9 image (build-spec.md
// Phase 10 grid-card placement), the exact same asset used as the article's
// own hero image (src/pages/[category]/[slug].astro) — never a different,
// homepage-only thumbnail. Every card image is offscreen/below the fold
// somewhere on every page that uses PostCard, so lazy-loading here is
// correct; the one LCP-critical cover (article hero) is handled separately
// in [category]/[slug].astro with loading="eager" + preload.
//
// Title and description are clamped to a fixed number of lines (not left to
// grow with content) so cards in the same row stay level regardless of how
// long any one post's title/description is — "Read more" is the one
// consistent way into the full article, not a variable-height blob of text.
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";
import ShareButtons from "./ShareButtons.astro";
import { getCategoryName, siteConfig } from "../config";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const categoryName = getCategoryName(post.data.category);
const href = `/${post.data.category}/${post.id}/`;
const absoluteUrl = new URL(href, siteConfig.url).href;
---

<div class="post-card-wrapper">
  <Card as="article" padding="none" class="post-card">
    <a href={href} class="post-card__link">
      <Picture
        src={post.data.coverImage}
        alt={post.data.coverImageAlt}
        widths={[640]}
        formats={["avif", "webp"]}
        loading="lazy"
        class="post-card__cover"
      />
      <div class="post-card__body">
        <p class="post-card__category">{categoryName}</p>
        <h3 class="post-card__title">{post.data.title}</h3>
        <p class="post-card__description">{post.data.description}</p>
        <p class="post-card__meta">
          <time datetime={post.data.date.toISOString()}>
            {
              post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
                timeZone: "UTC",
              })
            }
          </time>
          <span class="post-card__read-more">Read more →</span>
        </p>
      </div>
    </a>
  </Card>
  <ShareButtons
    url={absoluteUrl}
    title={post.data.title}
    class="post-card__share"
  />
</div>

<style>
  .post-card-wrapper {
    position: relative;
    height: 100%;
  }

  /*
   * A sibling of <Card>, not a child of it — Card.astro sets
   * overflow-hidden for its rounded corners, which would clip the share
   * dropdown's menu (it opens below the trigger and can extend past the
   * card's own bounds). Positioning it here, relative to this wrapper
   * instead of the card, keeps the menu unclipped while still visually
   * sitting in the cover image's corner.
   */
  :global(.post-card__share) {
    position: absolute;
    top: calc(var(--spacing) * 1.5);
    right: calc(var(--spacing) * 1.5);
    z-index: 10;
  }

  :global(.post-card__share .share-buttons__trigger) {
    background-color: rgba(11, 15, 13, 0.55);
    color: #f4f2ed;
    border-radius: 999px;
    backdrop-filter: blur(2px);
  }

  :global(.post-card__share .share-buttons__trigger:hover) {
    background-color: rgba(11, 15, 13, 0.75);
    color: #f4f2ed;
  }

  :global(.post-card__share .share-buttons__label) {
    display: none;
  }

  .post-card {
    height: 100%;
  }

  .post-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .post-card__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .post-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 1.5);
    padding: calc(var(--spacing) * 3);
  }

  .post-card__category {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-card__title {
    font-size: var(--text-lg);
    color: var(--color-fg);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__description {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__meta {
    margin-top: auto;
    padding-top: calc(var(--spacing) * 1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing);
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }

  .post-card__read-more {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .post-card__link:hover .post-card__read-more {
    text-decoration: underline;
  }
</style>

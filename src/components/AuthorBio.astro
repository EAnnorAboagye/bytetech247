---
// Single component reused at the bottom of every post (Phase 9) and on
// /about (wired below). Real identity resolved in build-spec.md §11
// (v3.2) — siteConfig.author.name/social are populated, and the real
// photo lives at src/assets/author-aboagye-annor.jpg. The `hasAuthor`
// fallback stays in place as a guard, not because it's expected to fire.
import { Image } from "astro:assets";
import { siteConfig } from "../config";
import authorPhoto from "../assets/author-aboagye-annor.jpg";

const hasAuthor = siteConfig.author.name.length > 0;
const socialLinks = Object.entries(siteConfig.social);
---

{
  hasAuthor ? (
    <div class="author-bio">
      <Image
        src={authorPhoto}
        alt={siteConfig.author.name}
        width={128}
        height={128}
        class="author-bio__avatar"
      />
      <div>
        <p class="author-bio__name">{siteConfig.author.name}</p>
        {siteConfig.author.bio && (
          <p class="author-bio__credentials">{siteConfig.author.bio}</p>
        )}
        {socialLinks.length > 0 && (
          <ul class="author-bio__links">
            {socialLinks.map(([label, href]) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  ) : (
    <p class="author-bio__placeholder">Author details coming soon.</p>
  )
}

<style>
  .author-bio {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 3);
  }

  .author-bio__avatar {
    width: calc(var(--spacing) * 8);
    height: calc(var(--spacing) * 8);
    border-radius: 9999px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .author-bio__name {
    font-weight: 600;
    color: var(--color-fg);
  }

  .author-bio__credentials {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .author-bio__links {
    list-style: none;
    display: flex;
    gap: calc(var(--spacing) * 2);
    margin: calc(var(--spacing) * 1) 0 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  .author-bio__links a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--color-accent);
    text-decoration: none;
  }

  .author-bio__placeholder {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    font-style: italic;
  }
</style>

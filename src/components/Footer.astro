---
// build-spec.md §10 — five columns on desktop, collapses to a stacked list
// on mobile (handled here by the Grid primitive's auto-fit reflow, no extra
// breakpoint logic needed). Identical on every route.
import { siFacebook, siInstagram, siTiktok, siX } from "simple-icons";
import { siteConfig, CATEGORIES } from "../config";
import Grid from "./layout/Grid.astro";
import Stack from "./layout/Stack.astro";

const year = new Date().getFullYear();
const socialLinks = Object.entries(siteConfig.social);

// §10 (locked, v3.2): each platform pairs its real brand mark with a text
// label, not a bare "@bytetech247" link. Path data comes straight from the
// simple-icons package (24x24 viewBox) rather than hand-typed bezier data,
// so every mark is the verified brand icon, not an approximation.
const SOCIAL_ICONS: Record<string, string> = {
  facebook: `<path d="${siFacebook.path}" fill="currentColor"/>`,
  x: `<path d="${siX.path}" fill="currentColor"/>`,
  instagram: `<path d="${siInstagram.path}" fill="currentColor"/>`,
  tiktok: `<path d="${siTiktok.path}" fill="currentColor"/>`,
};
const SOCIAL_LABELS: Record<string, string> = {
  facebook: "Facebook",
  x: "X",
  instagram: "Instagram",
  tiktok: "TikTok",
};
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <Grid minItemWidth="10rem" space="6">
      <Stack space="2">
        <p class="site-footer__site-name">{siteConfig.name}</p>
        <p class="site-footer__description">{siteConfig.description}</p>
        {
          socialLinks.length > 0 && (
            <div class="site-footer__social">
              <p class="site-footer__heading">Social handles</p>
              <ul class="site-footer__social-list">
                {socialLinks.map(([platform, href]) => (
                  <li>
                    <a href={href} class="site-footer__social-link">
                      <span
                        class="site-footer__social-icon"
                        aria-hidden="true"
                        set:html={`<svg viewBox="0 0 24 24" width="18" height="18">${SOCIAL_ICONS[platform] ?? ""}</svg>`}
                      />
                      {SOCIAL_LABELS[platform] ?? platform}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </Stack>

      <Stack space="2" as="nav" aria-label="Categories">
        <p class="site-footer__heading">Categories</p>
        <ul class="site-footer__list">
          {
            CATEGORIES.map((category) => (
              <li>
                <a href={`/${category.slug}/`}>{category.name}</a>
              </li>
            ))
          }
        </ul>
      </Stack>

      <Stack space="2" as="nav" aria-label="Company">
        <p class="site-footer__heading">Company</p>
        <ul class="site-footer__list">
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </Stack>

      <Stack space="2" as="nav" aria-label="Legal">
        <p class="site-footer__heading">Legal</p>
        <ul class="site-footer__list">
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms &amp; Conditions</a></li>
          <li>
            <a href="/affiliate-disclosure/">Affiliate/Advertising Disclosure</a
            >
          </li>
          <li><a href="/editorial-policy/">Editorial Policy</a></li>
          <li>
            <button
              type="button"
              class="site-footer__link-button"
              data-reopen-consent
            >
              Cookie preferences
            </button>
          </li>
        </ul>
      </Stack>

      <Stack space="2" as="nav" aria-label="Resources">
        <p class="site-footer__heading">Resources</p>
        <ul class="site-footer__list">
          <li><a href="/archive/">All posts</a></li>
          <li><a href="/rss.xml">RSS feed</a></li>
          <li><a href="/sitemap.xml">Sitemap</a></li>
        </ul>
      </Stack>
    </Grid>

    <p class="site-footer__copyright">&copy; {year} {siteConfig.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg-subtle);
  }

  .site-footer__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: calc(var(--spacing) * 6) calc(var(--spacing) * 4);
  }

  .site-footer__site-name {
    font-weight: 700;
    color: var(--color-fg);
  }

  .site-footer__description,
  .site-footer__heading {
    font-size: var(--text-sm);
  }

  .site-footer__heading {
    font-weight: 600;
    color: var(--color-fg);
  }

  .site-footer__description {
    color: var(--color-fg-muted);
  }

  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 0.5);
  }

  .site-footer__list a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding-block: calc(var(--spacing) * 0.25);
    color: var(--color-fg-muted);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .site-footer__link-button {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding-block: calc(var(--spacing) * 0.25);
    padding-inline: 0;
    background: none;
    border: none;
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
    font-family: inherit;
    cursor: pointer;
  }

  .site-footer__list a:hover,
  .site-footer__link-button:hover {
    color: var(--color-accent);
  }

  .site-footer__social {
    margin-top: calc(var(--spacing) * 2);
  }

  .site-footer__social-list {
    list-style: none;
    margin: calc(var(--spacing) * 1) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 0.5);
  }

  .site-footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 1.5);
    min-height: 24px;
    color: var(--color-fg-muted);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .site-footer__social-link:hover {
    color: var(--color-accent);
  }

  .site-footer__social-icon {
    display: inline-flex;
    color: currentColor;
    flex-shrink: 0;
  }

  .site-footer__copyright {
    margin-top: calc(var(--spacing) * 6);
    padding-top: calc(var(--spacing) * 4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }
</style>

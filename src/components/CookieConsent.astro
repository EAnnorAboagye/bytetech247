---
// Gates Google Analytics behind an actual consent choice — privacy.astro's
// "What may be added later" section explicitly promises this rather than
// just a mention on the page, so gtag.js only ever loads after Accept, not
// on every page view by default.
//
// Consent is stored in localStorage (not a cookie) as "cookie-consent":
// "granted" | "denied" — unset means "not asked yet," which is the only
// state that shows the banner. The Footer's "Cookie preferences" link
// clears this and reruns the same init logic, so a visitor can change
// their mind later without digging through browser settings.
import { siteConfig } from "../config";

const { analyticsId } = siteConfig;
---

<div
  id="cookie-consent"
  class="cookie-consent"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie preferences"
  hidden
>
  <p class="cookie-consent__text">
    This site uses Google Analytics to understand what content is useful — no
    ads, no cross-site tracking. See the <a href="/privacy/">Privacy Policy</a> for
    details.
  </p>
  <div class="cookie-consent__actions">
    <button
      type="button"
      class="cookie-consent__decline"
      data-consent-choice="denied"
    >
      Decline
    </button>
    <button
      type="button"
      class="cookie-consent__accept"
      data-consent-choice="granted"
    >
      Accept
    </button>
  </div>
</div>

<script define:vars={{ analyticsId }}>
  const STORAGE_KEY = "cookie-consent";
  const banner = document.getElementById("cookie-consent");

  function loadAnalytics() {
    if (!analyticsId || window.gtag) return;
    const script = document.createElement("script");
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${analyticsId}`;
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer || [];
    window.gtag = function gtag() {
      window.dataLayer.push(arguments);
    };
    window.gtag("js", new Date());
    window.gtag("config", analyticsId);
  }

  function applyConsent(choice) {
    localStorage.setItem(STORAGE_KEY, choice);
    if (banner) banner.hidden = true;
    if (choice === "granted") loadAnalytics();
  }

  function initConsent() {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === "granted") {
      loadAnalytics();
    } else if (stored !== "denied" && banner) {
      banner.hidden = false;
    }
  }

  document.addEventListener("click", (event) => {
    const choiceButton = event.target.closest("[data-consent-choice]");
    if (choiceButton) applyConsent(choiceButton.dataset.consentChoice);

    // Footer's "Cookie preferences" link — reopens the banner so a visitor
    // can change an earlier choice, rather than requiring them to dig
    // through browser settings to clear a site's storage.
    if (event.target.closest("[data-reopen-consent]") && banner) {
      banner.hidden = false;
    }
  });

  // Astro's ClientRouter swaps <body> content client-side without a full
  // reload — re-check consent state on every navigation, both to restore
  // the banner if a later page removed it from the DOM and to fire a
  // manual page_view (gtag's own history-based auto-tracking doesn't see
  // Astro's transition navigations).
  // Run immediately for the very first load (this script tag executes
  // synchronously as the page parses, before any "load" event), then again
  // on every subsequent astro:page-load — ClientRouter transitions swap
  // <body> content without a full reload, which would otherwise leave a
  // later page with no banner and no re-check of stored consent.
  initConsent();

  document.addEventListener("astro:page-load", () => {
    initConsent();
    if (window.gtag && localStorage.getItem(STORAGE_KEY) === "granted") {
      window.gtag("event", "page_view", {
        page_location: window.location.href,
        page_title: document.title,
      });
    }
  });
</script>

<style>
  .cookie-consent {
    position: fixed;
    z-index: 50;
    bottom: calc(var(--spacing) * 3);
    left: calc(var(--spacing) * 3);
    right: calc(var(--spacing) * 3);
    max-width: 32rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
    padding: calc(var(--spacing) * 3);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }

  .cookie-consent__text {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    margin: 0;
  }

  .cookie-consent__text a {
    color: var(--color-accent);
  }

  .cookie-consent__actions {
    display: flex;
    justify-content: flex-end;
    gap: calc(var(--spacing) * 2);
  }

  .cookie-consent__decline,
  .cookie-consent__accept {
    min-height: 44px;
    padding-inline: calc(var(--spacing) * 3);
    border-radius: 0.375rem;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .cookie-consent__decline {
    background-color: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-fg);
  }

  .cookie-consent__accept {
    background-color: var(--color-accent);
    border: 1px solid var(--color-accent);
    color: var(--color-accent-fg);
  }
</style>

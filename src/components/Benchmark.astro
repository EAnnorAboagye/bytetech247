---
// Static horizontal-bar comparison — no charting library, zero JS, per the
// static-first architecture. Author usage:
//   <Benchmark title="Cold build time" rows={[{ label: "Vite", value: 1.2, unit: "s" }, ...]} />
interface BenchmarkRow {
  label: string;
  value: number;
  unit?: string;
}

interface Props {
  title?: string;
  rows: BenchmarkRow[];
}

const { title, rows } = Astro.props;
const maxValue = Math.max(...rows.map((row) => row.value));
---

<figure class="benchmark">
  {title && <figcaption class="benchmark__title">{title}</figcaption>}
  <div class="benchmark__rows">
    {
      rows.map((row) => (
        <div class="benchmark__row">
          <span class="benchmark__label">{row.label}</span>
          <div class="benchmark__track">
            <div
              class="benchmark__bar"
              style={`width: ${(row.value / maxValue) * 100}%`}
            />
          </div>
          <span class="benchmark__value">
            {row.value}
            {row.unit ? ` ${row.unit}` : ""}
          </span>
        </div>
      ))
    }
  </div>
</figure>

<style>
  .benchmark {
    margin: calc(var(--spacing) * 4) 0;
  }

  .benchmark__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: calc(var(--spacing) * 2);
  }

  .benchmark__rows {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
  }

  .benchmark__row {
    display: grid;
    grid-template-columns: 8rem 1fr 5rem;
    align-items: center;
    gap: var(--spacing);
  }

  .benchmark__label {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .benchmark__track {
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    overflow: hidden;
    height: calc(var(--spacing) * 2);
  }

  .benchmark__bar {
    background-color: var(--color-accent);
    height: 100%;
  }

  .benchmark__value {
    font-size: var(--text-sm);
    color: var(--color-fg);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
</style>

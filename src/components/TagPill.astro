---
// A separate component from Badge because tags will eventually link to
// /tag/[slug] (Phase 9) — Badge is a static label, this is tag-specific.
// `href` is optional and deliberately omitted by callers until the /tag/
// route actually exists (build-spec.md §9); until then this renders as a
// plain non-linking pill rather than a dead link.
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
// py-1 (not py-0.5) so this still clears the 24px touch-target minimum
// on the day Phase 9 wires a real href into it.
const classes =
  "inline-flex items-center rounded-full border border-border bg-bg-subtle px-2 py-1 text-xs text-fg-muted";
---

{
  href ? (
    <a
      href={href}
      class:list={[classes, "hover:border-accent hover:text-fg", className]}
    >
      <slot />
    </a>
  ) : (
    <span class:list={[classes, className]}>
      <slot />
    </span>
  )
}

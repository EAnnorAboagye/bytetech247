---
// Cmd/Ctrl+K nav-jump + content search palette (Phase 5/8), using the
// native <dialog> element for free focus trapping, Escape-to-close, and
// ::backdrop support. Static pages/categories filter instantly client-side;
// real post-content matches come from Pagefind's build-time index
// (dist/pagefind/, generated by the `pagefind --site dist` postbuild
// step) loaded lazily on first query.
import { CATEGORIES, siteConfig } from "../config";

const staticPages = [
  { label: "Home", href: "/" },
  { label: "Archive", href: "/archive/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
  { label: "Privacy", href: "/privacy/" },
  { label: "Terms & Conditions", href: "/terms/" },
  { label: "Affiliate/Advertising Disclosure", href: "/affiliate-disclosure/" },
  { label: "Editorial Policy", href: "/editorial-policy/" },
];

const categoryPages = CATEGORIES.map((category) => ({
  label: category.name,
  href: `/${category.slug}/`,
}));

const destinations = [...staticPages, ...categoryPages];
---

{
  /* is:inline — ships exactly as written, with no Astro/Vite processing
     or bundling, so the literal import() below is invisible to Vite's
     static analysis (see the long comment on loadPagefind() in the
     module script further down for why that matters). Defining the
     function here doesn't fetch pagefind.js eagerly; only *calling*
     __loadPagefind() later triggers the import. */
}
<script is:inline>
  window.__loadPagefind = () => import("/pagefind/pagefind.js");
</script>

<dialog
  class="command-palette"
  aria-label={`Jump to a page on ${siteConfig.name}`}
>
  <div class="command-palette__box">
    <input
      type="text"
      class="command-palette__input"
      placeholder="Jump to a page…"
      aria-label="Jump to a page"
      autocomplete="off"
    />
    <ul class="command-palette__list" id="palette-pages">
      {
        destinations.map((dest) => (
          <li>
            <a href={dest.href} class="command-palette__item">
              {dest.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ul
      class="command-palette__list command-palette__list--results"
      id="palette-results"
      aria-live="polite"
      hidden
    >
    </ul>
    <p class="command-palette__hint" id="palette-hint">
      Type to jump to a page, or search post content.
    </p>
  </div>
</dialog>

<style>
  .command-palette {
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    width: min(32rem, 90vw);
    background-color: var(--color-bg);
    color: var(--color-fg);
  }

  .command-palette::backdrop {
    background-color: rgb(0 0 0 / 0.4);
  }

  .command-palette__box {
    display: flex;
    flex-direction: column;
    max-height: 70vh;
  }

  .command-palette__input {
    border: none;
    border-bottom: 1px solid var(--color-border);
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
    font-size: var(--text-base);
    background: none;
    color: var(--color-fg);
  }

  /* Visible focus, not a suppressed default (build-spec.md Phase 6) — this
     is the one input in the whole palette, so a keyboard user needs an
     unambiguous indicator that it's focused. */
  .command-palette__input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .command-palette__list {
    list-style: none;
    margin: 0;
    padding: calc(var(--spacing) * 2);
    overflow-y: auto;
  }

  .command-palette__item {
    display: block;
    padding: calc(var(--spacing) * 2);
    border-radius: 0.5rem;
    color: var(--color-fg);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .command-palette__item:hover,
  .command-palette__item.is-active {
    background-color: var(--color-bg-subtle);
    color: var(--color-accent);
  }

  .command-palette__excerpt {
    display: block;
    margin-top: calc(var(--spacing) * 0.5);
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
    font-weight: 400;
  }

  .command-palette__list--results:not([hidden]) {
    border-top: 1px solid var(--color-border);
  }

  .command-palette__hint {
    margin: 0;
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }
</style>

<script>
  interface PagefindResultData {
    url: string;
    meta: { title?: string };
    excerpt: string;
  }
  interface PagefindResult {
    id: string;
    data: () => Promise<PagefindResultData>;
  }
  interface PagefindModule {
    init: () => Promise<void>;
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  }

  const dialog = document.querySelector<HTMLDialogElement>(".command-palette");
  const resultsList = document.getElementById("palette-results");
  const hint = document.getElementById("palette-hint");

  // Loaded lazily on first real query rather than on page load — this is
  // an enhancement layered on top of the always-working static-page list
  // (build-spec.md Phase 7), so a missing/not-yet-built pagefind index
  // (e.g. local `astro dev` without the postbuild step) degrades silently
  // instead of breaking the palette.
  //
  // `window.__loadPagefind` is defined by a separate `is:inline` script
  // below rather than imported here directly — Vite wraps a literal
  // `import("/pagefind/pagefind.js")` in *this* script (which Astro does
  // bundle/analyze, since it has no is:inline) in its own modulepreload
  // helper and bakes in a `__VITE_PRELOAD__` placeholder for the chunk
  // list, but pagefind.js doesn't exist until the separate
  // `pagefind --site dist` step runs *after* the Vite/Astro build. Vite
  // can't resolve the placeholder for a file it never saw, so it ships
  // unreplaced — a bare, undeclared identifier — and every call throws
  // `ReferenceError: __VITE_PRELOAD__ is not defined` instead of loading
  // the module (confirmed live: this silently broke every search query in
  // production). `is:inline` opts that other script out of Astro/Vite's
  // processing entirely, so its `import()` call ships untouched and never
  // gets wrapped — Pagefind's own documented workaround for Vite-based
  // sites. This also avoids the `new Function("return import(...)")` trick
  // the workaround usually takes, which needs 'unsafe-eval' in
  // script-src; a real dynamic `import()` doesn't.
  let pagefindPromise: Promise<PagefindModule | null> | null = null;
  function loadPagefind(): Promise<PagefindModule | null> {
    if (!pagefindPromise) {
      pagefindPromise = (
        window as unknown as {
          __loadPagefind: () => Promise<PagefindModule>;
        }
      )
        .__loadPagefind()
        .then(async (mod) => {
          await mod.init();
          return mod;
        })
        .catch(() => null);
    }
    return pagefindPromise;
  }

  function openPalette() {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    const input = dialog.querySelector<HTMLInputElement>(
      ".command-palette__input",
    );
    if (input) {
      input.value = "";
      filterStaticItems("");
      clearResults();
      input.focus();
    }
    // Warm the index as soon as the palette opens, so the first keystroke
    // isn't the thing paying the network/init cost.
    void loadPagefind();
  }

  function filterStaticItems(query: string) {
    if (!dialog) return;
    const q = query.trim().toLowerCase();
    for (const item of dialog.querySelectorAll<HTMLElement>(
      "#palette-pages .command-palette__item",
    )) {
      const matches =
        q.length > 0 && (item.textContent ?? "").toLowerCase().includes(q);
      const li = item.closest("li");
      if (li) li.hidden = q.length === 0 ? false : !matches;
    }
  }

  function clearResults() {
    if (!resultsList) return;
    resultsList.replaceChildren();
    resultsList.hidden = true;
  }

  async function runContentSearch(query: string) {
    const q = query.trim();
    if (q.length < 2) {
      clearResults();
      return;
    }
    const pagefind = await loadPagefind();
    if (!pagefind) {
      if (hint)
        hint.textContent = "Content search isn't available on this build.";
      return;
    }
    const { results } = await pagefind.search(q);
    const items = await Promise.all(results.slice(0, 8).map((r) => r.data()));
    if (!resultsList) return;
    resultsList.replaceChildren();
    for (const item of items) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = item.url;
      a.className = "command-palette__item";
      a.append(item.meta.title ?? item.url);
      const excerpt = document.createElement("span");
      excerpt.className = "command-palette__excerpt";
      renderExcerpt(excerpt, item.excerpt);
      a.appendChild(excerpt);
      li.appendChild(a);
      resultsList.appendChild(li);
    }
    resultsList.hidden = items.length === 0;
    // A query that only matches content (not a static page name) should
    // still let Enter work immediately — select the first real result.
    const items_ = visibleItems();
    if (
      items_.length > 0 &&
      !items_.some((el) => el.classList.contains("is-active"))
    ) {
      setActive(items_, 0);
    }
  }

  // Pagefind's excerpt string wraps matched terms in <mark>...</mark> and
  // is meant to be inserted via innerHTML — but everything else in it is
  // the page's own indexed text verbatim, un-escaped (build-spec.md code
  // samples routinely contain literal `<`/`>`, e.g. `Array<string>`), so a
  // raw innerHTML assignment risks that text being parsed as markup
  // instead of displayed. Walking just the <mark> spans and treating
  // everything else as a text node keeps the highlighting without ever
  // interpreting excerpt content as HTML — and is what lets the CSP below
  // enforce Trusted Types without an explicit sanitizer policy.
  const MARK_TAG = /<mark>(.*?)<\/mark>/gs;
  function renderExcerpt(container: HTMLElement, excerpt: string) {
    let lastIndex = 0;
    for (const match of excerpt.matchAll(MARK_TAG)) {
      const index = match.index ?? 0;
      if (index > lastIndex) {
        container.append(excerpt.slice(lastIndex, index));
      }
      const mark = document.createElement("mark");
      mark.textContent = match[1];
      container.append(mark);
      lastIndex = index + match[0].length;
    }
    if (lastIndex < excerpt.length) {
      container.append(excerpt.slice(lastIndex));
    }
  }

  function visibleItems(): HTMLElement[] {
    if (!dialog) return [];
    return [
      ...dialog.querySelectorAll<HTMLElement>(".command-palette__item"),
    ].filter(
      (item) => !item.closest("li")?.hidden && !item.closest("ul")?.hidden,
    );
  }

  function setActive(items: HTMLElement[], index: number) {
    for (const item of items) item.classList.remove("is-active");
    const target = items[index];
    target?.classList.add("is-active");
    target?.scrollIntoView({ block: "nearest" });
  }

  document.addEventListener("keydown", (event) => {
    const isMac = navigator.platform.toUpperCase().includes("MAC");
    const modifierPressed = isMac ? event.metaKey : event.ctrlKey;
    if (modifierPressed && event.key.toLowerCase() === "k") {
      event.preventDefault();
      openPalette();
      return;
    }

    if (!dialog?.open) return;

    const items = visibleItems();
    const currentIndex = items.findIndex((item) =>
      item.classList.contains("is-active"),
    );

    if (event.key === "ArrowDown") {
      event.preventDefault();
      setActive(items, Math.min(currentIndex + 1, items.length - 1));
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      setActive(items, Math.max(currentIndex - 1, 0));
    } else if (event.key === "Enter") {
      event.preventDefault();
      // Fall back to the top visible result even if the user hasn't
      // pressed an arrow key yet — matches how most command palettes
      // behave, rather than requiring an extra keypress before Enter does
      // anything.
      const target = currentIndex >= 0 ? items[currentIndex] : items[0];
      target?.click();
    }
  });

  document.addEventListener("click", (event) => {
    const trigger = (event.target as HTMLElement).closest(
      "[data-command-palette-trigger]",
    );
    if (trigger) {
      openPalette();
      return;
    }

    // Click on the ::backdrop registers as a click on the <dialog> itself.
    if (event.target === dialog) {
      dialog?.close();
    }
  });

  let debounceHandle: ReturnType<typeof setTimeout> | undefined;
  document.addEventListener("input", (event) => {
    if (!(event.target as HTMLElement).matches(".command-palette__input"))
      return;
    const value = (event.target as HTMLInputElement).value;
    filterStaticItems(value);
    clearTimeout(debounceHandle);
    debounceHandle = setTimeout(() => runContentSearch(value), 150);
  });
</script>

---
// Cmd/Ctrl+K nav-jump palette (Phase 5). Full Pagefind content search is
// wired in here in Phase 8 — for now this only jumps to pages by name,
// using the native <dialog> element for free focus trapping, Escape-to-
// close, and ::backdrop support.
import { CATEGORIES, siteConfig } from "../config";

const staticPages = [
  { label: "Home", href: "/" },
  { label: "Archive", href: "/archive/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
  { label: "Privacy", href: "/privacy/" },
  { label: "Terms & Conditions", href: "/terms/" },
  { label: "Affiliate/Advertising Disclosure", href: "/affiliate-disclosure/" },
  { label: "Editorial Policy", href: "/editorial-policy/" },
];

const categoryPages = CATEGORIES.map((category) => ({
  label: category.name,
  href: `/${category.slug}/`,
}));

const destinations = [...staticPages, ...categoryPages];
---

<dialog
  class="command-palette"
  aria-label={`Jump to a page on ${siteConfig.name}`}
>
  <div class="command-palette__box">
    <input
      type="text"
      class="command-palette__input"
      placeholder="Jump to a page…"
      aria-label="Jump to a page"
      autocomplete="off"
    />
    <ul class="command-palette__list">
      {
        destinations.map((dest) => (
          <li>
            <a href={dest.href} class="command-palette__item">
              {dest.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="command-palette__hint">
      Full content search ships in Phase 8 — this jumps to pages by name for
      now.
    </p>
  </div>
</dialog>

<style>
  .command-palette {
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    width: min(32rem, 90vw);
    background-color: var(--color-bg);
    color: var(--color-fg);
  }

  .command-palette::backdrop {
    background-color: rgb(0 0 0 / 0.4);
  }

  .command-palette__box {
    display: flex;
    flex-direction: column;
    max-height: 70vh;
  }

  .command-palette__input {
    border: none;
    border-bottom: 1px solid var(--color-border);
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
    font-size: var(--text-base);
    background: none;
    color: var(--color-fg);
  }

  .command-palette__input:focus {
    outline: none;
  }

  .command-palette__list {
    list-style: none;
    margin: 0;
    padding: calc(var(--spacing) * 2);
    overflow-y: auto;
  }

  .command-palette__item {
    display: block;
    padding: calc(var(--spacing) * 2);
    border-radius: 0.5rem;
    color: var(--color-fg);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .command-palette__item:hover,
  .command-palette__item.is-active {
    background-color: var(--color-bg-subtle);
    color: var(--color-accent);
  }

  .command-palette__hint {
    margin: 0;
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".command-palette");

  function openPalette() {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    const input = dialog.querySelector<HTMLInputElement>(
      ".command-palette__input",
    );
    if (input) {
      input.value = "";
      filterItems("");
      input.focus();
    }
  }

  function filterItems(query: string) {
    if (!dialog) return;
    const q = query.trim().toLowerCase();
    for (const item of dialog.querySelectorAll<HTMLElement>(
      ".command-palette__item",
    )) {
      const matches = (item.textContent ?? "").toLowerCase().includes(q);
      const li = item.closest("li");
      if (li) li.hidden = !matches;
      item.classList.remove("is-active");
    }
  }

  function visibleItems(): HTMLElement[] {
    if (!dialog) return [];
    return [
      ...dialog.querySelectorAll<HTMLElement>(".command-palette__item"),
    ].filter((item) => !item.closest("li")?.hidden);
  }

  function setActive(items: HTMLElement[], index: number) {
    for (const item of items) item.classList.remove("is-active");
    const target = items[index];
    target?.classList.add("is-active");
    target?.scrollIntoView({ block: "nearest" });
  }

  document.addEventListener("keydown", (event) => {
    const isMac = navigator.platform.toUpperCase().includes("MAC");
    const modifierPressed = isMac ? event.metaKey : event.ctrlKey;
    if (modifierPressed && event.key.toLowerCase() === "k") {
      event.preventDefault();
      openPalette();
      return;
    }

    if (!dialog?.open) return;

    const items = visibleItems();
    const currentIndex = items.findIndex((item) =>
      item.classList.contains("is-active"),
    );

    if (event.key === "ArrowDown") {
      event.preventDefault();
      setActive(items, Math.min(currentIndex + 1, items.length - 1));
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      setActive(items, Math.max(currentIndex - 1, 0));
    } else if (event.key === "Enter" && currentIndex >= 0) {
      event.preventDefault();
      items[currentIndex].click();
    }
  });

  document.addEventListener("click", (event) => {
    const trigger = (event.target as HTMLElement).closest(
      "[data-command-palette-trigger]",
    );
    if (trigger) {
      openPalette();
      return;
    }

    // Click on the ::backdrop registers as a click on the <dialog> itself.
    if (event.target === dialog) {
      dialog?.close();
    }
  });

  document.addEventListener("input", (event) => {
    if (!(event.target as HTMLElement).matches(".command-palette__input"))
      return;
    filterItems((event.target as HTMLInputElement).value);
  });
</script>

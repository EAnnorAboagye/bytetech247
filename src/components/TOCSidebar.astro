---
// Structural TOC container (Phase 2), enhanced in Phase 3 with a
// scroll-spy active-item highlight ("<TableOfContents> (scroll-spy)" per
// build-spec.md Phase 3). The script below is a pure progressive
// enhancement — every link is a real #anchor and the TOC is fully usable
// with zero JS; the script only adds the "currently reading" highlight.
//
// Two variants, rendered as separate copies in [slug].astro (same pattern
// as Header.astro's PrimaryNav) so CSS alone decides which one shows —
// no JS reparenting, no device detection:
//   - "sidebar": sticky column, >=1024px, next to the article.
//   - "inline": collapsible <details> in the content flow, <1024px. Below
//     that width the sidebar column collapses to a single stack, which
//     used to leave the TOC stranded at the very bottom of the page,
//     after the related-posts section — useless by the time a reader
//     scrolls that far. This variant is what tablet/mobile readers
//     actually get instead.
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
  variant?: "sidebar" | "inline";
}

const { headings = [], variant = "sidebar" } = Astro.props;
---

{
  headings.length > 0 && variant === "sidebar" && (
    <nav aria-label="Table of contents" class="toc-sidebar">
      <p class="toc-sidebar__heading">On this page</p>
      <ul class="toc-list toc-sidebar__list">
        {headings.map((heading) => (
          <li
            class:list={[
              "toc-sidebar__item",
              `toc-sidebar__item--depth-${heading.depth}`,
            ]}
          >
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

{
  headings.length > 0 && variant === "inline" && (
    <details class="toc-inline">
      <summary>
        On this page <span aria-hidden="true">&#9662;</span>
      </summary>
      <ul class="toc-list toc-inline__list">
        {headings.map((heading) => (
          <li
            class:list={[
              "toc-inline__item",
              `toc-inline__item--depth-${heading.depth}`,
            ]}
          >
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<style>
  .toc-sidebar {
    position: sticky;
    top: calc(var(--spacing) * 4);
    font-size: var(--text-sm);
  }

  .toc-sidebar__heading {
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: calc(var(--spacing) * 2);
  }

  .toc-sidebar__list {
    border-left: 1px solid var(--color-border);
  }

  .toc-sidebar__item {
    padding-left: calc(var(--spacing) * 2);
  }

  .toc-sidebar__item--depth-3 {
    padding-left: calc(var(--spacing) * 4);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing);
  }

  .toc-list a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--color-fg-muted);
    text-decoration: none;
  }

  .toc-list a:hover {
    color: var(--color-accent);
  }

  .toc-list a.is-active {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* Inline (mobile/tablet, <1024px) — a collapsible disclosure sitting in
     the normal content flow near the top of the article, not a sticky
     column. Touch target sized (44px) since this is exactly the range
     that's read on a phone/tablet. */
  .toc-inline {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: calc(var(--spacing) * 3);
    margin: calc(var(--spacing) * 4) 0;
    font-size: var(--text-sm);
  }

  .toc-inline > summary {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 0.5);
    min-height: 44px;
    font-weight: 600;
    color: var(--color-fg);
    cursor: pointer;
    list-style: none;
  }

  .toc-inline > summary::-webkit-details-marker {
    display: none;
  }

  .toc-inline[open] > summary {
    margin-bottom: var(--spacing);
  }

  .toc-inline__item {
    padding-left: calc(var(--spacing) * 2);
  }

  .toc-inline__item--depth-3 {
    padding-left: calc(var(--spacing) * 4);
  }

  .toc-inline .toc-list a {
    min-height: 44px;
  }
</style>

<script>
  // Astro's View Transitions swap page content client-side without a full
  // reload, so a plain top-level scan (as opposed to one keyed off
  // astro:page-load) would only ever see the *first* page's headings —
  // scroll-spy would silently stop updating after the first navigation.
  // astro:page-load fires on the initial load too, so this doesn't also
  // need a direct call. Both the sidebar and inline variants' links share
  // the .toc-list class, so one query covers whichever is visible.
  let observer: IntersectionObserver | null = null;

  function setupScrollSpy() {
    observer?.disconnect();

    const links = document.querySelectorAll<HTMLAnchorElement>(".toc-list a");
    if (links.length === 0) return;

    const headingByLink = new Map<HTMLAnchorElement, HTMLElement>();
    for (const link of links) {
      const heading = document.getElementById(link.hash.slice(1));
      if (heading) headingByLink.set(link, heading);
    }

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const activeHeadingLinks =
            document.querySelectorAll<HTMLAnchorElement>(
              `.toc-list a[href="#${entry.target.id}"]`,
            );
          if (activeHeadingLinks.length === 0) continue;
          for (const link of links) link.classList.remove("is-active");
          for (const link of activeHeadingLinks)
            link.classList.add("is-active");
        }
      },
      { rootMargin: "0px 0px -70% 0px" },
    );

    for (const heading of headingByLink.values()) observer.observe(heading);
  }

  document.addEventListener("astro:page-load", setupScrollSpy);
</script>

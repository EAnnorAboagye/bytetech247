---
// Manual, CLS-safe ad placement — replaces relying on Auto Ads (which
// injects wherever Google decides, with no reserved space) for fixed
// homepage/article/sidebar spots. Renders nothing if no slot ID is
// configured in src/config.ts (siteConfig.adSlots) — a missing slot ID
// is a safe no-op, not a broken <ins> tag with an empty data-ad-slot.
//
// The reserved space is load-bearing, not decorative: it's set before
// the AdSense script has run, so the layout never shifts once the
// creative (or nothing, if unfilled) loads in — the one part of "premium
// ad placement" that's also a real Core Web Vitals (CLS) fix.
//
// `size`, not a raw `minHeight` string — every call site previously
// passed a fixed pixel value as an inline `--ad-slot-min-height` custom
// property, which (being an inline style) always outranks anything a
// later stylesheet media query tries to set on the same property, so
// there was structurally no way to reserve a shorter box on a narrow
// viewport than on desktop. `size` instead selects a `data-ad-size`
// bucket (see the `.ad-slot[data-ad-size=...]` rules in global.css),
// letting the actual min-height live entirely in CSS, where a `@media`
// override can win normally. Google's own auto/full-width-responsive
// format renders a shorter unit on a narrow container than a wide one,
// so a single fixed reservation across every breakpoint either wastes
// space on mobile or risks looking oversized once real ads are live.
//
// Three buckets, matching every size actually used sitewide:
// - "banner": slim top-of-page (homepageHeader, articleHeader)
// - "rectangle": the default, most in-content/in-article placements
// - "tower": the desktop-only sidebar — its parent is display:none below
//   the tablet breakpoint (.post-sidebar in [slug].astro), so this one
//   never actually needs its own mobile/tablet value
type AdSize = "banner" | "rectangle" | "tower";

// .ad-slot/.ad-slot__label styling and the adsbygoogle activation script
// both live globally now (global.css's `components` layer, and
// BaseLayout.astro respectively) instead of in this component's own
// scoped <style>/<script> — the in-article rehype plugins
// (rehype-quick-answer.mjs, rehype-in-article-ads.mjs) emit this same
// markup shape directly into the compiled MDX tree, outside Astro's
// component-scoping system, and need to match this component's styling
// exactly rather than duplicating it.
//
// Prop is named `adSlot`, not `slot` — Astro reserves a `slot` attribute
// on any component tag for named-slot content projection. A literal
// <AdSlot slot={...} /> written as a direct child of a real component
// (e.g. <Stack>, <BaseLayout>) got silently intercepted as "project this
// into a named slot" instead of passed through as a prop, and since
// neither component declares a matching named slot, the whole instance
// vanished with no error — confirmed live (2026-08-11): every top-level
// homepage AdSlot rendered nothing until this rename, while the same
// component nested inside a .map() callback (one JS-expression boundary
// removed from the literal parent tag) rendered fine.
import { siteConfig } from "../config";

interface Props {
  adSlot: string;
  size: AdSize;
  label?: string;
  class?: string;
}

const { adSlot, size, label = "Advertisement", class: className } = Astro.props;
const adClient = siteConfig.adsensePublisherId;
---

{
  adSlot && (
    <div class:list={["ad-slot", className]} data-ad-size={size}>
      <p class="ad-slot__label">{label}</p>
      <ins
        class="adsbygoogle"
        style="display:block;width:100%;height:100%"
        data-ad-client={adClient}
        data-ad-slot={adSlot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
    </div>
  )
}

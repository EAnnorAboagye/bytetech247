---
// Every Layout "Grid" — a responsive auto-fit grid with no media queries
// and no runtime reflow (pure CSS, computed at build time per build-spec.md
// §4's bento-grid performance requirement).
interface Props {
  space?: string;
  minItemWidth?: string;
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}

const {
  space = "4",
  minItemWidth = "16rem",
  as: Tag = "div",
  class: className,
  ...rest
} = Astro.props as Props & Record<string, unknown>;
---

<Tag
  class:list={["auto-grid", className]}
  style={`--grid-space: calc(var(--spacing) * ${space}); --grid-min-item-width: ${minItemWidth}`}
  {...rest}
>
  <slot />
</Tag>

<style>
  .auto-grid {
    display: grid;
    /* auto-fill, not auto-fit — auto-fit collapses empty tracks once
       there are fewer items than would fit a row, so the 1fr on the
       *existing* items' tracks then stretches them to fill the freed
       space instead. With few posts across the site right now (several
       category/related/recent sections genuinely have just one card),
       that meant a single card stretching to the full content width
       instead of staying at its natural size. auto-fill keeps those
       extra tracks in place (empty, but still reserved), so real items
       stay left-aligned at minItemWidth regardless of how many there
       are — same multi-column behavior once there are enough items to
       fill a row either way. */
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(var(--grid-min-item-width, 16rem), 100%), 1fr)
    );
    gap: var(--grid-space, var(--spacing));
  }
</style>

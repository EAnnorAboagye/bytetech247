---
// Every Layout "Stack" — vertical rhythm between children via flex gap.
// `space` is a multiplier of the Phase 1 --spacing token (8px grid), not a
// raw length, so this component can only ever land on the grid.
interface Props {
  space?: string;
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}

const {
  space = "4",
  as: Tag = "div",
  class: className,
  ...rest
} = Astro.props as Props & Record<string, unknown>;
---

<Tag
  class:list={["stack", className]}
  style={`--stack-space: calc(var(--spacing) * ${space})`}
  {...rest}
>
  <slot />
</Tag>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--stack-space, var(--spacing));
  }
</style>

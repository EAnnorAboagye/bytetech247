---
// Featured/hero tile for the homepage's top post. Uses the exact same cover
// image as the article itself and PostCard (never a separate hero-only
// image) at the same 16:9 ratio as every other thumbnail on the site — the
// only thing that makes this tile "featured" is its larger size, not a
// different image treatment.
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCategoryName } from "../config";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const categoryName = getCategoryName(post.data.category);
const href = `/${post.data.category}/${post.id}/`;
---

<article class="hero-tile" data-category={post.data.category}>
  <a href={href} class="hero-tile__link">
    <div class="hero-tile__cover-wrap">
      <Picture
        src={post.data.coverImage}
        alt={post.data.coverImageAlt}
        widths={[1200]}
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        class="hero-tile__cover"
      />
      <span class="hero-tile__badge">{categoryName}</span>
    </div>
    <div class="hero-tile__body">
      <h2 class="hero-tile__title">{post.data.title}</h2>
      <p class="hero-tile__description">{post.data.description}</p>
      <span class="hero-tile__read-more">Read more →</span>
    </div>
  </a>
</article>

<style>
  .hero-tile {
    position: relative;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    overflow: hidden;
    background-color: var(--color-bg-subtle);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--duration-base) var(--ease-out-expo),
      box-shadow var(--duration-base) var(--ease-out-expo),
      border-color var(--duration-base) var(--ease-out-expo);
  }

  .hero-tile:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
    box-shadow: var(--shadow-card-hover);
  }

  .hero-tile::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background-color: var(--card-accent, var(--color-accent));
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tile {
      transition: none;
    }

    .hero-tile:hover {
      transform: none;
    }
  }

  .hero-tile__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .hero-tile__cover-wrap {
    position: relative;
  }

  .hero-tile__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .hero-tile__badge {
    position: absolute;
    top: calc(var(--spacing) * 2);
    left: calc(var(--spacing) * 2);
    padding: calc(var(--spacing) * 0.5) calc(var(--spacing) * 1.5);
    border-radius: 999px;
    background-color: var(--card-accent, var(--color-accent));
    color: var(--color-accent-fg);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
  }

  .hero-tile__body {
    padding: calc(var(--spacing) * 5) calc(var(--spacing) * 5)
      calc(var(--spacing) * 6);
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
  }

  .hero-tile__title {
    font-size: var(--text-3xl);
    font-family: var(--font-serif);
    letter-spacing: normal;
    color: var(--color-fg);
    /* Titles regularly contain long code identifiers (pull_request_target,
       actions/checkout) with no natural break point — without this, one
       long token can force the whole line wide instead of wrapping,
       compounding the mobile font-size issue below. */
    overflow-wrap: anywhere;
  }

  /* text-3xl's fluid clamp() still lands close to its ~2.14rem floor on a
     phone-width viewport — fine for a short headline, but this site's
     titles are often long technical strings ("actions/checkout v7 Blocks
     pull_request_target PRs"), which at that size wrapped to 5 lines and
     pushed the excerpt below the fold before a mobile visitor saw any
     actual content. Step down one scale on narrow viewports specifically,
     rather than lowering text-3xl's own floor for every other use of it
     sitewide. */
  @media (max-width: 40rem) {
    .hero-tile__title {
      font-size: var(--text-2xl);
    }
  }

  .hero-tile__description {
    font-size: var(--text-base);
    color: var(--color-fg-muted);
    max-width: 40rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-tile__read-more {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .hero-tile__link:hover .hero-tile__read-more {
    text-decoration: underline;
  }
</style>

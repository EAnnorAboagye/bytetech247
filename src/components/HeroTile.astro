---
// Featured/hero tile for the homepage's top post. Uses the exact same cover
// image as the article itself and PostCard (never a separate hero-only
// image) at the same 16:9 ratio as every other thumbnail on the site — the
// only thing that makes this tile "featured" is its larger size, not a
// different image treatment.
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCategoryName } from "../config";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const categoryName = getCategoryName(post.data.category);
const href = `/${post.data.category}/${post.id}/`;
---

<article class="hero-tile" data-category={post.data.category}>
  <a href={href} class="hero-tile__link">
    <Picture
      src={post.data.coverImage}
      alt={post.data.coverImageAlt}
      widths={[1200]}
      formats={["avif", "webp"]}
      loading="eager"
      fetchpriority="high"
      class="hero-tile__cover"
    />
    <div class="hero-tile__body">
      <p class="hero-tile__category">{categoryName}</p>
      <h2 class="hero-tile__title">{post.data.title}</h2>
      <p class="hero-tile__description">{post.data.description}</p>
      <span class="hero-tile__read-more">Read more →</span>
    </div>
  </a>
</article>

<style>
  .hero-tile {
    position: relative;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    overflow: hidden;
    background-color: var(--color-bg-subtle);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--duration-base) var(--ease-out-expo),
      box-shadow var(--duration-base) var(--ease-out-expo),
      border-color var(--duration-base) var(--ease-out-expo);
  }

  .hero-tile:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
    box-shadow: var(--shadow-card-hover);
  }

  .hero-tile::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background-color: var(--card-accent, var(--color-accent));
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tile {
      transition: none;
    }

    .hero-tile:hover {
      transform: none;
    }
  }

  .hero-tile__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .hero-tile__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .hero-tile__body {
    padding: calc(var(--spacing) * 5) calc(var(--spacing) * 5)
      calc(var(--spacing) * 6);
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
  }

  .hero-tile__category {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--card-accent, var(--color-accent));
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-tile__title {
    font-size: var(--text-3xl);
    font-family: var(--font-serif);
    letter-spacing: normal;
    color: var(--color-fg);
  }

  .hero-tile__description {
    font-size: var(--text-base);
    color: var(--color-fg-muted);
    max-width: 40rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-tile__read-more {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .hero-tile__link:hover .hero-tile__read-more {
    text-decoration: underline;
  }
</style>

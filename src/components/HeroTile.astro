---
// Bento hero tile. Background is a layered color-mix()/radial-gradient
// mesh — zero bytes, zero decode time — per build-spec.md §4's design ->
// score mapping ("rendered as CSS, not an image file").
import type { CollectionEntry } from "astro:content";
import { getCategoryName } from "../config";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const categoryName = getCategoryName(post.data.category);
const href = `/${post.data.category}/${post.id}/`;
---

<article class="hero-tile">
  <a href={href} class="hero-tile__link">
    <p class="hero-tile__category">{categoryName}</p>
    <h2 class="hero-tile__title">{post.data.title}</h2>
    <p class="hero-tile__description">{post.data.description}</p>
  </a>
</article>

<style>
  .hero-tile {
    position: relative;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    overflow: hidden;
    background-color: var(--color-bg-subtle);
    background-image:
      radial-gradient(
        at 20% 20%,
        color-mix(in oklch, var(--color-accent) 25%, transparent),
        transparent 60%
      ),
      radial-gradient(
        at 80% 0%,
        color-mix(in oklch, var(--color-accent) 15%, transparent),
        transparent 55%
      ),
      radial-gradient(
        at 100% 100%,
        color-mix(in oklch, var(--color-accent) 10%, transparent),
        transparent 55%
      );
  }

  .hero-tile__link {
    display: block;
    padding: calc(var(--spacing) * 8) calc(var(--spacing) * 6);
    color: inherit;
    text-decoration: none;
  }

  .hero-tile__category {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-tile__title {
    font-size: var(--text-3xl);
    margin-top: calc(var(--spacing) * 2);
    color: var(--color-fg);
  }

  .hero-tile__description {
    font-size: var(--text-base);
    margin-top: calc(var(--spacing) * 2);
    color: var(--color-fg-muted);
    max-width: 40rem;
  }
</style>

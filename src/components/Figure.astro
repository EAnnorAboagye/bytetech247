---
// alt is deliberately required (no `?`) — build/type error if omitted.
// The HTML `title` attribute is deliberately not used anywhere here; it
// carries no meaningful SEO weight, unlike `alt` (build-spec.md Phase 3).
//
// <Picture>, not <Image> — emits a real <picture> with AVIF as the
// primary source and WebP as fallback, both generated at build time from
// the one source asset. No separate compression pipeline to maintain;
// Astro's own image service (sharp) already does this per-format.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  // Only present when the image is a sourced Pexels photo (the
  // write-article skill's Pexels fallback path) — omitted for an
  // author's own screenshot/diagram, never fabricated. Pexels' license
  // doesn't require this, but a visible credit is a real trust/E-E-A-T
  // signal, and it's cheap to show.
  credit?: { name: string; url: string };
}

const { src, alt, caption, credit } = Astro.props;
---

<figure class="figure">
  <Picture
    src={src}
    alt={alt}
    formats={["avif", "webp"]}
    loading="lazy"
    class="figure__image"
  />
  {
    (caption || credit) && (
      <figcaption class="figure__caption">
        {caption}
        {caption && credit && " "}
        {credit && (
          <>
            Photo by{" "}
            <a href={credit.url} rel="noopener">
              {credit.name}
            </a>
          </>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin: calc(var(--spacing) * 4) 0;
  }

  .figure__image {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
  }

  .figure__caption {
    margin-top: var(--spacing);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    text-align: center;
  }

  .figure__caption a {
    color: inherit;
  }
</style>
